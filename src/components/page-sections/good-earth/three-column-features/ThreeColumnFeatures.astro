---
interface FeatureItem {
  title: string;
  body: string;
  icon: string;
}

const {
  eyebrow = "",
  headingItalic = "",
  headingPlain = "",
  items = [] as FeatureItem[],
  _component,
  useDefaultEditableBinding: _ueb,
  ...htmlAttributes
} = Astro.props;

const icons: Record<string, string> = {
  farm: `<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>`,
  sea: `<path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>`,
  garden: `<path d="M7 20h10"/><path d="M10 20c5.5-2.5.8-6.4 3-10"/><path d="M9.5 9.4c1.1.8 1.8 2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z"/><path d="M14.1 6a7 7 0 0 1 1.7 10.7"/><path d="M14 12.4c.8-1.1 2-1.8 3.7-2.3.4 2 .4 3.5-.3 4.8-.6 1.2-1.9 2.3-4.2 3-.5-2.8 0-4.4.8-5.5z"/>`,
  people: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  award: `<line x1="12" y1="17" x2="12" y2="21"/><line x1="8" y1="21" x2="16" y2="21"/><path d="M7 4h10v7a5 5 0 0 1-5 5v0a5 5 0 0 1-5-5V4z"/><path d="M7 9H3v-2a4 4 0 0 1 4-4"/><path d="M17 9h4v-2a4 4 0 0 0-4-4"/>`,
  heart: `<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>`,
  leaf: `<path d="M2 22 16 8"/><path d="M3.47 12.53A5 5 0 0 0 5 21a5 5 0 0 0 8.47-3.53C14 12 12 2 12 2c0 0-9.88 5.44-8.53 10.53z"/>`,
  star: `<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>`,
};

const revealClass = ["st-up", "st-up-d", "st-up-dl"];
---

<section class="st-section" {...htmlAttributes}>
  <div class="st-wrap">
    <div class="st-features-intro st-up">
      <span class="st-sub">{eyebrow}</span>
      <h2 class="st-title-l st-up-d">
        <span><em>{headingItalic}</em><br />{headingPlain}</span>
      </h2>
    </div>

    <div class="st-features-grid">
      {items.map((item, i) => (
        <div class:list={["st-feature", revealClass[i % 3]]}>
          <div class="st-feature-icon" aria-hidden="true">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={icons[item.icon] ?? ""}
            />
          </div>
          <h3 class="st-feature-title">{item.title}</h3>
          <p class="st-feature-body">{item.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .st-features-intro {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .st-features-intro .st-title-l {
    margin-bottom: 0;
  }
  .st-features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    padding-top: clamp(2rem, 4vw, 3rem);
  }
  .st-feature {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .st-feature-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.04);
    color: var(--gold);
    border-radius: 10px;
    flex-shrink: 0;
  }
  .st-feature-title {
    font-family: var(--font-headline);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(1.8rem, 2.8vw, 2.6rem);
    line-height: 1;
    color: var(--text);
    margin: 0;
  }
  .st-feature-body {
    font-family: var(--font-display);
    font-size: 0.9rem;
    line-height: 1.85;
    color: var(--mid);
    margin: 0;
  }

  .cms-editor-active .st-up,
  .cms-editor-active .st-up-d,
  .cms-editor-active .st-up-dl,
  .cms-editor-active .st-right,
  .cms-editor-active .st-right-d,
  .cms-editor-active .st-scale,
  .cms-editor-active .st-wide {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }

  @media (max-width: 960px) {
    .st-features-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>

<script>
  (function () {
    if ((window as any).inEditorMode) return;
    const w = window as Window & { __stReveal?: boolean };
    if (!w.__stReveal) {
      w.__stReveal = true;
      const sel = ".st-up,.st-up-d,.st-up-dl,.st-right,.st-right-d,.st-scale,.st-wide";
      const reveals = document.querySelectorAll<HTMLElement>(sel);
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("is-vis");
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.11 }
      );
      reveals.forEach((el) => io.observe(el));
    }
  })();
</script>
