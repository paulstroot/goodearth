---
import globalData from "@data/global.json";

interface HoursRow {
  label: string;
  dayStart: number; // 0=Sun, 1=Mon, …, 6=Sat
  dayEnd: number;
  open: string;     // 24h "HH:MM"
  close: string;    // 24h "HH:MM"
}

interface HoursException {
  date: string;    // ISO datetime string — matched annually by UTC month and day
  open?: string;   // 12h "H:MM am/pm" — empty string for all-day closure
  close?: string;  // 12h "H:MM am/pm" — empty string for all-day closure
  label: string;   // shown in badge, e.g. "Christmas" → "CLOSED FOR CHRISTMAS"
}

interface Button {
  text: string;
  href: string;
  style?: "dark" | "outline" | "light";
  external?: boolean;
}

const defaultAddress = `${globalData.address.streetAddress}\n${globalData.address.addressLocality}, ${globalData.address.addressRegion} ${globalData.address.postalCode}`;

const {
  eyebrow = "",
  headingItalic = "",
  headingPlain = "",
  address = defaultAddress,
  phone = globalData.telephone,
  phoneHref = globalData.phoneHref,
  mapEmbedUrl = "",
  directionsUrl = "",
  directionsLabel = "Get Directions",
  hours = globalData.hours as HoursRow[],
  exceptions = globalData.exceptions as HoursException[],
  buttons = [] as Button[],
  _component,
  useDefaultEditableBinding: _ueb,
  ...htmlAttributes
} = Astro.props;

const addressLines = (address as string).split("\n").filter(Boolean);

function formatTime(t: string): string {
  const [h, m] = t.split(":").map(Number);
  const suffix = h >= 12 ? "pm" : "am";
  const h12 = h % 12 || 12;

  return m === 0 ? `${h12}${suffix}` : `${h12}:${String(m).padStart(2, "0")}${suffix}`;
}

const todayUTC = new Date();

todayUTC.setUTCHours(0, 0, 0, 0);

const cutoffUTC = new Date(todayUTC.getTime() + 14 * 24 * 60 * 60 * 1000);

const upcomingExceptions = (exceptions as HoursException[]).filter((exc) => {
  const d = new Date(exc.date);

  d.setUTCHours(0, 0, 0, 0);

  return d >= todayUTC && d <= cutoffUTC;
});
---

<section
  class="st-section"
  {...htmlAttributes}
>
  <div class="st-wrap">
    <div class="st-loc-grid">
      <!-- Map column -->
      <div class="st-loc-map-col st-wide">
        <div class="st-loc-map-frame">
          <iframe
            title={`${headingItalic} ${headingPlain} location`}
            src={mapEmbedUrl}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
        {
          directionsUrl && (
            <a
              href={directionsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="st-loc-directions st-up-d"
            >
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polygon points="3 11 22 2 13 21 11 13 3 11" />
              </svg>
              {directionsLabel}
            </a>
          )
        }
      </div>

      <!-- Details column -->
      <div class="st-loc-details-col">
        <span class="st-sub st-up">{eyebrow}</span>

        <div class="st-loc-name-row st-up-d">
          <h2 class="st-title-l st-loc-name">
            <span><em>{headingItalic}</em><br />{headingPlain}</span>
          </h2>
          <span
            class="st-loc-badge"
            id="st-loc-badge"
            data-hours={JSON.stringify(hours)}
            data-exceptions={JSON.stringify(exceptions)}
            hidden
          ></span>
        </div>

        {
          (address || phone) && (
            <div class="st-loc-detail-block st-up-dl">
              <h3 class="st-loc-detail-label">Address</h3>
              {addressLines.length > 0 && (
                <address class="st-loc-address">
                  {addressLines.map((line, i) => (
                    <>
                      {i > 0 && <br />}
                      {line}
                    </>
                  ))}
                </address>
              )}
              {phone && (
                <a
                  href={phoneHref || `tel:${phone.replace(/\D/g, "")}`}
                  class="st-loc-phone"
                >
                  {phone}
                </a>
              )}
            </div>
          )
        }

        {
          hours.length > 0 && (
            <div class="st-loc-detail-block st-up-dl">
              <h3 class="st-loc-detail-label">Hours</h3>
              <table class="st-loc-hours">
                <tbody>
                  {hours.map((row: HoursRow) => (
                    <tr>
                      <td>{row.label}</td>
                      <td>
                        <strong>
                          {formatTime(row.open)} – {formatTime(row.close)}
                        </strong>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }

        {
          upcomingExceptions.length > 0 && (
            <div class="st-loc-detail-block st-up-dl">
              <h3 class="st-loc-detail-label">Holiday & Special Hours</h3>
              <table class="st-loc-hours">
                <tbody>
                  {upcomingExceptions.map((exc) => (
                    <tr class="st-loc-hours--exception">
                      <td>Closed {exc.label}</td>
                      <td>
                        <strong>
                          {exc.open && exc.close ? `${exc.open} – ${exc.close}` : "All day"}
                        </strong>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }

        {
          buttons.length > 0 && (
            <div class="st-loc-actions st-up-dl">
              {buttons.map((btn: Button) => (
                <a
                  href={btn.href}
                  class:list={["st-btn", `st-btn--${btn.style ?? "dark"}`]}
                  target={btn.external ? "_blank" : undefined}
                  rel={btn.external ? "noopener noreferrer" : undefined}
                >
                  {btn.text}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style is:global>
  .st-loc-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(3rem, 6vw, 7rem);
    align-items: start;
  }

  /* ─── Map column ─── */
  .st-loc-map-col {
    display: flex;
    flex-direction: column;
  }
  .st-loc-map-frame {
    width: 100%;
    aspect-ratio: 4 / 3.2;
    overflow: hidden;
    border-radius: 3px;
    background: #e8e4dc;
  }
  .st-loc-map-frame iframe {
    width: 100%;
    height: 100%;
    display: block;
  }
  .st-loc-directions {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .st-loc-directions:hover {
    color: #5c4426;
  }

  /* ─── Details column ─── */
  .st-loc-name-row {
    display: flex;
    align-items: flex-end;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .st-loc-name {
    margin-bottom: 0 !important;
  }
  .st-loc-badge {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4a7a3e;
    background: rgba(74, 122, 62, 0.1);
    border: 1px solid rgba(74, 122, 62, 0.3);
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: 2.1rem;
    flex-shrink: 0;
  }
  .st-loc-badge--closed {
    color: #a03020;
    background: rgba(160, 48, 32, 0.08);
    border-color: rgba(160, 48, 32, 0.25);
  }
  .st-loc-detail-block {
    margin-bottom: 2.2rem;
  }
  .st-loc-detail-label {
    font-family: var(--font-sans) !important;
    font-size: 0.68rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.2em !important;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.35) !important;
    margin-bottom: 0.75rem !important;
  }
  .st-loc-address {
    font-style: normal;
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text);
    margin-bottom: 0.5rem;
  }
  .st-loc-phone {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--gold);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
  }
  .st-loc-phone:hover {
    color: #5c4426;
  }
  .st-loc-hours {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }
  .st-loc-hours tr {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  .st-loc-hours td {
    padding: 0.65rem 0;
    color: var(--mid);
  }
  .st-loc-hours td:last-child {
    text-align: right;
    color: var(--text);
  }
  .st-loc-hours--exception td {
    color: #a03020;
  }
  .st-loc-hours--exception td:last-child {
    color: #a03020;
  }
  .st-loc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (max-width: 900px) {
    .st-loc-grid {
      grid-template-columns: 1fr;
    }
    .st-loc-map-frame {
      aspect-ratio: 16 / 9;
    }
  }
  @media (max-width: 560px) {
    .st-loc-actions {
      flex-direction: column;
    }
  }
</style>

<script>
  (function () {
    if ((window as any).inEditorMode) return;

    const badge = document.getElementById("st-loc-badge") as HTMLElement | null;
    if (!badge) return;

    interface HoursRow { label: string; dayStart: number | string; dayEnd: number | string; open: string; close: string; }
    interface HoursException { date: string; open?: string; close?: string; label: string; }

    const hours: HoursRow[] = JSON.parse(badge.dataset.hours || "[]");
    const exceptions: HoursException[] = JSON.parse(badge.dataset.exceptions || "[]");

    function inDayRange(day: number, start: number, end: number): boolean {
      return start <= end ? day >= start && day <= end : day >= start || day <= end;
    }

    function toMinutes(t: string): number {
      const lower = t.toLowerCase().trim();
      const isPm = lower.includes("pm");
      const timePart = lower.replace(/\s*[ap]m/, "").trim();
      const [h, m] = timePart.split(":").map(Number);
      let hours = h;
      if (isPm && h !== 12) hours += 12;
      if (!isPm && h === 12) hours = 0; // 12:xx am → midnight
      return hours * 60 + (m || 0);
    }

    function parseExceptionDate(dateStr: string): { month: number; day: number } {
      const d = new Date(dateStr);
      return { month: d.getUTCMonth() + 1, day: d.getUTCDate() };
    }

    function statusFromRange(
      nowMin: number,
      openMin: number,
      closeMin: number,
      closedLabel: string
    ): { text: string; closed: boolean } {
      if (nowMin < openMin) {
        const diff = openMin - nowMin;
        return diff <= 60
          ? { text: `OPENS IN ${diff} MIN`, closed: true }
          : { text: closedLabel, closed: true };
      }
      if (nowMin >= closeMin) return { text: closedLabel, closed: true };
      const remaining = closeMin - nowMin;
      return remaining <= 60
        ? { text: `CLOSING IN ${remaining} MIN`, closed: false }
        : { text: "NOW OPEN", closed: false };
    }

    function getStatus(): { text: string; closed: boolean } {
      const now = new Date();
      const parts = new Intl.DateTimeFormat("en-US", {
        timeZone: "America/Chicago",
        weekday: "short",
        month: "numeric",
        day: "numeric",
        hour: "numeric",
        minute: "numeric",
        hour12: false,
      }).formatToParts(now);

      const get = (type: string) => parts.find((p) => p.type === type)?.value ?? "0";
      const dayMap: Record<string, number> = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
      const currentWeekday = dayMap[get("weekday")] ?? -1;
      const currentMonth = parseInt(get("month"), 10);
      const currentDay = parseInt(get("day"), 10);
      const nowMin = parseInt(get("hour"), 10) * 60 + parseInt(get("minute"), 10);

      // Check exceptions first (matched by UTC month and day, annually)
      const exc = exceptions.find((e) => {
        const { month: em, day: ed } = parseExceptionDate(e.date);
        return em === currentMonth && ed === currentDay;
      });

      if (exc) {
        const closedLabel = `CLOSED FOR ${exc.label.toUpperCase()}`;
        if (!exc.open || !exc.close) return { text: closedLabel, closed: true };
        return statusFromRange(nowMin, toMinutes(exc.open), toMinutes(exc.close), closedLabel);
      }

      // Regular hours
      const row = hours.find((r) => inDayRange(currentWeekday, Number(r.dayStart), Number(r.dayEnd)));
      if (!row) return { text: "CLOSED", closed: true };
      return statusFromRange(nowMin, toMinutes(row.open), toMinutes(row.close), "CLOSED");
    }

    const { text, closed } = getStatus();
    badge.textContent = text;
    badge.classList.toggle("st-loc-badge--closed", closed);
    badge.hidden = false;
  })();
</script>
