---
import menusJson from "@data/menus.json";

const {
  eyebrow = "",
  headingItalic = "",
  headingPlain = "",
  _component,
  useDefaultEditableBinding: _ueb,
  ...htmlAttributes
} = Astro.props;

const menus = menusJson.menus.map((m) => ({
  label: m.name,
  href: m.source,
  svgPath: m.icon,
}));
---

<div
  class="st-menus-outer"
  {...htmlAttributes}
>
  <div class="st-wrap st-menus-block st-up">
    <div class="st-menus-header">
      <span class="st-sub">{eyebrow}</span>
      <h2 class="st-title-l"><span><em>{headingItalic}</em><br />{headingPlain}</span></h2>
    </div>
    <div class="st-menu-grid">
      {
        menus.map((menu) => (
          <a
            href={menu.href}
            target="_blank"
            rel="noopener noreferrer"
            class="st-menu-card"
          >
            <div
              class="st-menu-card-icon"
              aria-hidden="true"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={menu.svgPath}
              />
            </div>
            <div class="st-menu-card-text">
              <strong>{menu.label}</strong>
              <span>PDF →</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</div>

<style is:global>
  .st-menus-outer {
    background: var(--bg);
    /* padding-block: clamp(1.5rem, 3vw, 2.5rem); */
  }
  .st-menus-block {
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    padding-top: clamp(2rem, 4vw, 4rem);
    padding-bottom: clamp(5rem, 9vh, 9rem);
  }
  .st-menus-header {
    margin-block: clamp(1.5rem, 3vw, 2.5rem);
  }
  .st-menus-header .st-title-l {
    margin-bottom: 0;
  }
  .st-menu-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(0.5rem, 1vw, 1rem);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .st-menu-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    background: rgba(0, 0, 0, 0.035);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    text-decoration: none;
    color: var(--text);
    opacity: 0;
    transform: translateX(-22px);
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      opacity 0.6s ease,
      transform 0.6s ease;
  }
  .st-menu-card.is-vis {
    opacity: 1;
    transform: none;
  }
  .st-menu-card.is-vis:hover {
    background: rgba(140, 110, 60, 0.09);
    border-color: var(--gold);
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.08);
  }
  .st-menu-card:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  .st-menu-card-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.7);
    color: var(--gold);
    border-radius: 8px;
    flex-shrink: 0;
    transition: background 0.2s ease;
  }
  .st-menu-card:hover .st-menu-card-icon {
    background: var(--gold);
    color: #fff;
  }
  .st-menu-card-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .st-menu-card-text strong {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text);
  }
  .st-menu-card-text span {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
  }

  @media (max-width: 860px) {
    .st-menu-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 560px) {
    .st-menu-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  (function () {
    // Staggered left-to-right card reveal
    const menuGrid = document.querySelector<HTMLElement>(".st-menu-grid");
    if (menuGrid) {
      const cards = [...menuGrid.querySelectorAll<HTMLElement>(".st-menu-card")];
      const io = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) {
            cards.forEach((card, i) => {
              setTimeout(() => card.classList.add("is-vis"), i * 300);
            });
            io.disconnect();
          }
        },
        { threshold: 0.15 }
      );
      io.observe(menuGrid);
    }
  })();
</script>
