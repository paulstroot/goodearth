---
const {
  eyebrow = "",
  headingItalic = "",
  headingPlain = "",
  subtitle = "",
  imageSrc = "",
  imageAlt = "",
  imageWidth = 1600,
  imageHeight = 1067,
  _component,
  useDefaultEditableBinding: _ueb,
  ...htmlAttributes
} = Astro.props;
---

<section class="st-hero" aria-label="Good Earth Restaurant" {...htmlAttributes}>
  <div class="st-hero-media">
    <img
      class="st-hero-img"
      src={imageSrc}
      alt={imageAlt}
      width={imageWidth}
      height={imageHeight}
      fetchpriority="high"
    />
  </div>
  <div class="st-hero-veil" aria-hidden="true"></div>
  <div class="st-hero-content">
    <span class="st-sub">{eyebrow}</span>
    <h1 class="st-hero-title">
      <span><em>{headingItalic}</em><br />{headingPlain}</span>
    </h1>
    {subtitle && <p class="st-hero-sub">{subtitle}</p>}
  </div>
  <div class="st-hero-scroll" aria-hidden="true">
    <svg
      width="18"
      height="32"
      viewBox="0 0 18 32"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
      stroke-linecap="round"
    >
      <line x1="9" y1="0" x2="9" y2="28"></line>
      <polyline points="2,21 9,28 16,21"></polyline>
    </svg>
  </div>
  <div class="st-hero-curve" aria-hidden="true">
    <svg
      viewBox="0 0 1440 240"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        class="st-hero-curve-fill"
        d="M0,240 L0,100 C280,92 520,20 820,100 C1020,152 1260,216 1440,196 L1440,240 Z"
      ></path>
    </svg>
  </div>
</section>

<style is:global>
  .st-hero {
    position: relative;
    height: calc(100svh - var(--nav-height));
    min-height: 480px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    background: #111;
  }
  .st-hero-media {
    position: absolute;
    inset: -15% 0 0;
  }
  .st-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
    will-change: transform;
  }
  .st-hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(8, 6, 4, 0.9) 0%,
      rgba(8, 6, 4, 0.42) 42%,
      rgba(8, 6, 4, 0.08) 100%
    );
    z-index: 1;
  }
  .st-hero-content {
    position: relative;
    z-index: 2;
    padding: 0 clamp(1.5rem, 6vw, 7rem) clamp(8rem, 40vh, 26rem);
    color: #fff;
    will-change: transform;
  }
  .st-hero-content .st-sub {
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 1.2rem;
    animation: st-hero-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0s both;
  }
  .st-hero-title {
    font-family: var(--font-headline);
    font-weight: 300;
    font-size: clamp(5rem, 11vw, 11rem);
    line-height: 0.8;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0;
    animation: st-hero-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }
  .st-hero-title em {
    font-style: italic;
  }
  .st-hero-sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.55);
    margin: 1rem 0 0;
    animation: st-hero-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
  }
  @keyframes st-hero-in {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .st-hero-curve {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    z-index: 3;
    pointer-events: none;
    line-height: 0;
  }
  .st-hero-curve svg {
    display: block;
    width: 100%;
    height: clamp(120px, 17vw, 240px);
  }
  .st-hero-curve-fill {
    fill: var(--bg);
  }
  .st-hero-scroll {
    position: absolute;
    bottom: 2.5rem;
    right: clamp(1.5rem, 4vw, 4rem);
    z-index: 4;
    color: rgba(255, 255, 255, 0.35);
    animation: st-bob 2.4s ease-in-out infinite;
  }
  @keyframes st-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  @media (max-width: 560px) {
    .st-hero-title {
      font-size: clamp(2.8rem, 13vw, 5rem);
      line-height: 0.95;
    }
    .st-hero-content {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }
</style>

<script>
  (function () {
    // Scroll-reveal — guarded so only one instance runs per page load
    const w = window as Window & { __stReveal?: boolean };
    if (!w.__stReveal) {
      w.__stReveal = true;
      const sel = ".st-up,.st-up-d,.st-up-dl,.st-right,.st-right-d,.st-scale,.st-wide";
      const reveals = document.querySelectorAll<HTMLElement>(sel);
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("is-vis");
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.11 }
      );
      reveals.forEach((el) => io.observe(el));
    }

    // Hero parallax
    const heroImg = document.querySelector<HTMLElement>(".st-hero-img");
    const heroContent = document.querySelector<HTMLElement>(".st-hero-content");
    const heroEl = document.querySelector<HTMLElement>(".st-hero");
    let ticking = false;

    function updateHero() {
      ticking = false;
      const sy = window.scrollY;
      if (heroImg) heroImg.style.transform = `translateY(${sy * 0.26}px)`;
      if (heroContent && heroEl) {
        const progress = Math.min(sy / heroEl.offsetHeight, 1);
        heroContent.style.transform = `translateY(${progress * 170}px)`;
      }
    }

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(updateHero);
          ticking = true;
        }
      },
      { passive: true }
    );
    updateHero();
  })();
</script>
