---
// src/components/page-sections/page-hero/PageHero.astro
// Shared full-viewport hero for inner pages (Locations, Careers, etc.)
// Props mirror the About hero so all inner pages feel consistent.
interface Props {
  label: string;
  title: string;        // HTML string — <em> and <br /> are fine
  subtitle?: string;
  image: string;
  imageAlt?: string;
  imagePosition?: string;
  curveFill?: string;   // CSS color — should match the page background below
}

const {
  label,
  title,
  subtitle,
  image,
  imageAlt = "",
  imagePosition = "center 30%",
  curveFill = "#f3f1eb",
} = Astro.props;
---

<section class="ph-hero">
  <div class="ph-media">
    <img
      class="ph-img"
      src={image}
      alt={imageAlt}
      width="1600"
      height="1067"
      fetchpriority="high"
    />
  </div>
  <div class="ph-veil" aria-hidden="true"></div>
  <div class="ph-content">
    <span class="ph-label">{label}</span>
    <h1 class="ph-title" set:html={title}></h1>
    {subtitle && <p class="ph-sub">{subtitle}</p>}
  </div>
  <div class="ph-curve" aria-hidden="true">
    <svg viewBox="0 0 1440 240" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path
        d="M0,240 L0,100 C280,92 520,20 820,100 C1020,152 1260,216 1440,196 L1440,240 Z"
        fill={curveFill}
      ></path>
    </svg>
  </div>
</section>

<style define:vars={{ imagePosition }}>
  .ph-hero {
    position: relative;
    height: calc(100svh - var(--nav-height));
    min-height: 540px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    background: #111;
  }
  .ph-media { position: absolute; inset: 0; }
  .ph-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--imagePosition);
    display: block;
    will-change: transform;
  }
  .ph-veil {
    position: absolute; inset: 0;
    background: linear-gradient(
      to top,
      rgba(8, 6, 4, 0.88) 0%,
      rgba(8, 6, 4, 0.5) 40%,
      rgba(8, 6, 4, 0.1) 100%
    );
    z-index: 1;
  }
  .ph-content {
    position: relative; z-index: 2;
    padding: 0 clamp(1.5rem, 6vw, 7rem) clamp(8rem, 40vh, 26rem);
    color: #fff;
    will-change: transform;
  }
  .ph-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 1rem;
    animation: ph-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0s both;
  }
  .ph-title {
    font-family: var(--font-headline) !important;
    font-weight: 300 !important;
    font-size: clamp(5rem, 11vw, 11rem) !important;
    line-height: 0.9 !important;
    letter-spacing: -0.02em !important;
    color: #fff !important;
    margin: 0 0 1rem !important;
    animation: ph-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.18s both;
  }
  .ph-title :global(em) { font-style: italic; }
  .ph-sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
    animation: ph-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
  }
  @keyframes ph-in {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .ph-curve {
    position: absolute; bottom: 0; left: 0; width: 100%;
    z-index: 3; pointer-events: none; line-height: 0;
  }
  .ph-curve svg {
    display: block; width: 100%; height: clamp(120px, 17vw, 240px);
  }

  @media (max-width: 560px) {
    .ph-title { font-size: clamp(3rem, 13vw, 5rem) !important; }
    .ph-content { padding-left: 1.5rem; padding-right: 1.5rem; }
  }
</style>

<script>
  (function () {
    const heroEl = document.querySelector(".ph-hero") as HTMLElement | null;
    const heroImg = heroEl?.querySelector(".ph-img") as HTMLElement | null;
    const heroContent = heroEl?.querySelector(".ph-content") as HTMLElement | null;
    if (!heroImg || !heroEl) return;
    let ticking = false;
    function update() {
      ticking = false;
      const sy = window.scrollY;
      heroImg.style.transform = `translateY(${sy * 0.26}px)`;
      if (heroContent) {
        heroContent.style.transform = `translateY(${
          Math.min(sy / heroEl.offsetHeight, 1) * 170
        }px)`;
      }
    }
    window.addEventListener("scroll", () => {
      if (!ticking) { requestAnimationFrame(update); ticking = true; }
    }, { passive: true });
    update();
  })();
</script>
