---
import globalData from "@data/global.json";

export interface Props {
  site: {
    name: string;
    url: string;
    logoSource: string;
    description: string;
  };
}

const { site } = Astro.props;

const DAY_NAMES = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];

function hoursToSpec(row: { dayStart: number; dayEnd: number; open: string; close: string }) {
  const days: string[] = [];
  let d = row.dayStart;
  while (true) {
    days.push(DAY_NAMES[d]);
    if (d === row.dayEnd) break;
    d = (d + 1) % 7;
  }
  return { "@type": "OpeningHoursSpecification", dayOfWeek: days, opens: row.open, closes: row.close };
}

const structuredData: Record<string, any> = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  name: site.name,
  url: site.url,
  logo: site.url + site.logoSource,
  description: site.description,
  telephone: globalData.telephone,
  address: {
    "@type": "PostalAddress",
    ...globalData.address,
  },
  openingHoursSpecification: globalData.hours.map(hoursToSpec),
  servesCuisine: ["American", "Natural Foods"],
  priceRange: "$$",
  reservationUrl: globalData.reservationUrl,
};
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(structuredData)}
/>
