---
// src/components/navigation/Footer.astro
import footerJson from "@data/footer.json";
import menusJson from "@data/menus.json";

const socialIcons: Record<string, string> = {
  facebook: `<path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>`,
  instagram: `<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>`,
  x: `<path d="M4 4l16 16M20 4L4 20"/>`,
};

const menuLinks = menusJson.menus.map((m) => ({
  name: m.name,
  path: m.source,
  isExternal: m.type === "pdf",
}));

const navColumns = footerJson.navColumns.map((col) => ({
  ...col,
  links: col.links.flatMap((link) => (link.name === "[MENUS]" ? menuLinks : [link])),
}));

const { brand, socials, visit, copyrightName, copyrightLink } = footerJson;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand -->
      <div class="footer-brand">
        <a
          href="/"
          class="footer-logo"
          aria-label={`${brand.logoAlt} – Home`}
        >
          <img
            src={brand.logoSrc}
            alt={brand.logoAlt}
            class="footer-logo-img"
          />
        </a>
        <p class="footer-tagline">{brand.tagline}</p>
        <p class="footer-desc">{brand.description}</p>
        <div class="footer-social">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill={s.platform === "facebook" ? "currentColor" : "none"}
                  stroke={s.platform !== "facebook" ? "currentColor" : undefined}
                  stroke-width={s.platform !== "facebook" ? "2" : undefined}
                  stroke-linecap={s.platform !== "facebook" ? "round" : undefined}
                  stroke-linejoin={s.platform !== "facebook" ? "round" : undefined}
                  aria-hidden="true"
                  set:html={socialIcons[s.platform] ?? ""}
                />
              </a>
            ))
          }
        </div>
      </div>

      <!-- Nav columns -->
      {
        navColumns.map((col) => (
          <div class="footer-nav">
            <h3>{col.heading}</h3>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a
                    href={(link as any).path}
                    target={(link as any).isExternal ? "_blank" : undefined}
                    rel={(link as any).isExternal ? "noopener noreferrer" : undefined}
                  >
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <!-- Visit -->
      <div class="footer-nav">
        <h3>{visit.heading}</h3>
        <address>
          <p>
            {
              visit.addressLines.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))
            }
          </p>
          <p><a href={visit.phoneHref}>{visit.phone}</a></p>
          <p class="footer-hours">
            {
              visit.hoursLines.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))
            }
          </p>
        </address>
        <a
          href={visit.reserveHref}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--outline footer-reserve-btn"
        >
          {visit.reserveText}
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {new Date().getFullYear()}
        {copyrightName}. Part of the <a
          href={copyrightLink.href}
          target="_blank"
          rel="noopener noreferrer"
          >{copyrightLink.text}</a
        >.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-green-dark);
    color: rgba(255, 255, 255, 0.85);
    padding: var(--space-16) 0 0;
    margin-top: 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: var(--space-10);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  /* Brand */
  .footer-logo {
    display: inline-flex;
    text-decoration: none;
    margin-bottom: var(--space-2);
  }
  .footer-logo-img {
    height: 64px;
    width: auto;
    display: block;
  }
  .footer-tagline {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-earth-light);
    margin-bottom: var(--space-4);
  }
  .footer-desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-loose);
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: var(--space-5);
  }

  .footer-social {
    display: flex;
    gap: var(--space-3);
  }
  .footer-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.75);
    transition:
      background var(--transition-fast),
      color var(--transition-fast);
  }
  .footer-social a:hover {
    background: var(--color-earth-light);
    color: var(--color-green-dark);
  }
  .footer-social a:focus-visible {
    outline: 2px solid var(--color-earth-light);
    outline-offset: 2px;
  }

  /* Nav columns */
  .footer-nav h3 {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-earth-light);
    margin-bottom: var(--space-4);
  }
  .footer-nav ul {
    list-style: none;
  }
  .footer-nav li {
    margin-bottom: var(--space-2);
  }
  .footer-nav a {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .footer-nav a:hover {
    color: var(--color-white);
  }
  .footer-nav a.btn:hover {
    color: var(--color-green-dark);
  }

  /* Address */
  address {
    font-style: normal;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: var(--leading-loose);
    color: rgba(255, 255, 255, 0.7);
  }
  address p {
    margin-bottom: var(--space-3);
  }
  address a {
    color: rgba(255, 255, 255, 0.7);
  }
  address a:hover {
    color: var(--color-white);
  }
  .footer-hours {
    color: rgba(255, 255, 255, 0.55);
  }

  .footer-reserve-btn {
    margin-top: var(--space-4);
    border-color: rgba(255, 255, 255, 0.35);
    color: var(--color-white);
    font-size: var(--text-xs);
    padding: var(--space-2) var(--space-5);
  }
  .footer-reserve-btn:hover {
    background: var(--color-white);
    color: var(--color-green-dark);
    border-color: var(--color-white);
  }

  /* Bottom */
  .footer-bottom {
    padding: var(--space-5) 0;
  }
  .footer-copy {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.38);
    margin: 0;
  }
  .footer-copy a {
    color: rgba(255, 255, 255, 0.5);
  }
  .footer-copy a:hover {
    color: var(--color-white);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 540px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
