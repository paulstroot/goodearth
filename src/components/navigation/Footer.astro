---
// src/components/navigation/Footer.astro
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">

      <!-- Brand -->
      <div class="footer-brand">
        <a href="/" class="footer-logo">Good Earth</a>
        <p class="footer-tagline">Natural, Unprocessed</p>
        <p class="footer-desc">Cooking in harmony with the seasons since 1974. Committed to freshness, purity, and responsible sourcing.</p>
        <div class="footer-social">
          <a href="https://www.facebook.com/goodearthmn" target="_blank" rel="noopener noreferrer" aria-label="Good Earth on Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/good_earth_edina/" target="_blank" rel="noopener noreferrer" aria-label="Good Earth Edina on Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <div class="footer-nav">
        <h3>Explore</h3>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/locations">Location &amp; Hours</a></li>
          <li><a href="/careers">Careers</a></li>
        </ul>
      </div>

      <!-- Menus -->
      <div class="footer-nav">
        <h3>Menus</h3>
        <ul>
          <li><a href="/menu/pdf/Good_Earth_Breakfast_Menu.pdf" target="_blank" rel="noopener noreferrer">Breakfast Menu</a></li>
          <li><a href="/menu/pdf/Good_Earth_Lunch_Dinner_Menu.pdf" target="_blank" rel="noopener noreferrer">Lunch &amp; Dinner</a></li>
          <li><a href="/menu/seasonal-specials">Seasonal Specials</a></li>
          <li><a href="/menu/pdf/Good_Earth_Kids_Menu.pdf" target="_blank" rel="noopener noreferrer">Kids Menu</a></li>
          <li><a href="/menu/pdf/Good-Earth-Event-Platters.pdf" target="_blank" rel="noopener noreferrer">Event Platters</a></li>
        </ul>
      </div>

      <!-- Visit -->
      <div class="footer-nav">
        <h3>Visit Us</h3>
        <address>
          <p>In the Galleria<br />3460 Galleria<br />Edina, MN 55435</p>
          <p><a href="tel:9529251001">(952) 925-1001</a></p>
          <p class="footer-hours">
            Mon – Sat: 8am – 8pm<br />
            Sun: 8am – 7pm
          </p>
        </address>
        <a
          href="https://www.opentable.com/restref/client/?rid=27313&restref=27313"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--outline footer-reserve-btn"
        >
          Reserve a Table
        </a>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="footer-copy">&copy; {new Date().getFullYear()} Good Earth Restaurant. Part of the <a href="https://www.parasole.com" target="_blank" rel="noopener noreferrer">Parasole Family of Restaurants</a>.</p>
    </div>
  </div>
</footer>

<style>
.site-footer {
  background: var(--color-green-dark);
  color: rgba(255,255,255,0.85);
  padding: var(--space-16) 0 0;
  margin-top: var(--space-20);
}

.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1.5fr;
  gap: var(--space-10);
  padding-bottom: var(--space-12);
  border-bottom: 1px solid rgba(255,255,255,0.12);
}

/* Brand */
.footer-logo {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: 700;
  font-style: italic;
  color: var(--color-white);
  text-decoration: none;
  display: block;
  margin-bottom: var(--space-2);
}
.footer-tagline {
  font-family: var(--font-sans);
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-earth-light);
  margin-bottom: var(--space-4);
}
.footer-desc {
  font-family: var(--font-body);
  font-size: var(--text-sm);
  line-height: var(--leading-loose);
  color: rgba(255,255,255,0.6);
  margin-bottom: var(--space-5);
}

.footer-social {
  display: flex;
  gap: var(--space-3);
}
.footer-social a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.75);
  transition: background var(--transition-fast), color var(--transition-fast);
}
.footer-social a:hover {
  background: var(--color-earth-light);
  color: var(--color-green-dark);
}
.footer-social a:focus-visible {
  outline: 2px solid var(--color-earth-light);
  outline-offset: 2px;
}

/* Nav columns */
.footer-nav h3 {
  font-family: var(--font-sans);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-earth-light);
  margin-bottom: var(--space-4);
}
.footer-nav ul { list-style: none; }
.footer-nav li { margin-bottom: var(--space-2); }
.footer-nav a {
  font-family: var(--font-sans);
  font-size: var(--text-sm);
  color: rgba(255,255,255,0.7);
  text-decoration: none;
  transition: color var(--transition-fast);
}
.footer-nav a:hover { color: var(--color-white); }

/* Address */
address {
  font-style: normal;
  font-family: var(--font-sans);
  font-size: var(--text-sm);
  line-height: var(--leading-loose);
  color: rgba(255,255,255,0.7);
}
address p { margin-bottom: var(--space-3); }
address a { color: rgba(255,255,255,0.7); }
address a:hover { color: var(--color-white); }
.footer-hours { color: rgba(255,255,255,0.55); }

.footer-reserve-btn {
  margin-top: var(--space-4);
  border-color: rgba(255,255,255,0.35);
  color: var(--color-white);
  font-size: var(--text-xs);
  padding: var(--space-2) var(--space-5);
}
.footer-reserve-btn:hover {
  background: var(--color-white);
  color: var(--color-green-dark);
  border-color: var(--color-white);
}

/* Bottom */
.footer-bottom {
  padding: var(--space-5) 0;
}
.footer-copy {
  font-family: var(--font-sans);
  font-size: var(--text-xs);
  color: rgba(255,255,255,0.38);
  margin: 0;
}
.footer-copy a { color: rgba(255,255,255,0.5); }
.footer-copy a:hover { color: var(--color-white); }

/* Responsive */
@media (max-width: 900px) {
  .footer-grid {
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }
  .footer-brand { grid-column: 1 / -1; }
}

@media (max-width: 540px) {
  .footer-grid { grid-template-columns: 1fr; }
}
</style>
