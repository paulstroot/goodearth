---
// src/components/navigation/Header.astro
import navJson from "@data/mainNav.json";
import menusJson from "@data/menus.json";

const menuChildren = menusJson.menus.map((m) => ({
  label: m.name,
  href: m.source,
  isPdf: m.type === "pdf",
}));

interface NavChild {
  label: string;
  href: string;
  isPdf?: boolean;
  isExternal?: boolean;
}

interface NavItem {
  label: string;
  href?: string;
  isCta?: boolean;
  isExternal?: boolean;
  children?: NavChild[];
}

const navItems: NavItem[] = navJson.navData.map((item) => ({
  label: item.name,
  href: (item as any).path as string | undefined,
  isCta: (item as any).isCta as boolean | undefined,
  isExternal: (item as any).isExternal as boolean | undefined,
  children: item.children?.flatMap((child): NavChild[] =>
    child.name === "[MENUS]"
      ? menuChildren
      : [
          {
            label: child.name,
            href: (child as any).path as string,
            isPdf: (child as any).isPdf as boolean | undefined,
            isExternal: (child as any).isExternal as boolean | undefined,
          },
        ]
  ),
}));

const currentPath = Astro.url.pathname;
---

<a
  href="#main-content"
  class="skip-link"
  >Skip to main content</a
>

<header
  class="site-header"
  role="banner"
>
  <div class="container header-inner">
    <!-- Logo -->
    <a
      href="/"
      class="site-logo"
      aria-label="Good Earth Restaurant – Home"
    >
      <img
        src="/images/logo-text-only.svg"
        alt="Good Earth"
        class="site-logo-img"
      />
    </a>

    <!-- Desktop Nav -->
    <nav
      class="main-nav"
      aria-label="Main navigation"
    >
      <ul
        class="nav-list"
        role="list"
      >
        {
          navItems.map((item) => (
            <li
              class:list={[
                `nav-item`,
                `${item.children ? "has-dropdown" : ""}`,
                `${item.isCta ? "nav-item--cta" : ""}`,
              ]}
            >
              {item.children ? (
                <button
                  class="nav-link nav-link--toggle"
                  aria-haspopup="true"
                  aria-expanded="false"
                >
                  {item.label}
                  <svg
                    class="nav-chevron"
                    width="10"
                    height="6"
                    viewBox="0 0 10 6"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M1 1L5 5L9 1"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    />
                  </svg>
                </button>
              ) : (
                <a
                  href={item.href}
                  class:list={[
                    `nav-link`,
                    `${item.isCta ? "nav-link--cta btn btn--primary" : ""}`,
                    `${currentPath === item.href ? "is-active" : ""}`,
                  ]}
                  target={item.isExternal ? "_blank" : undefined}
                  rel={item.isExternal ? "noopener noreferrer" : undefined}
                >
                  {item.label}
                </a>
              )}
              {item.children && (
                <ul
                  class="dropdown"
                  role="list"
                >
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="dropdown-link"
                        target={child.isExternal || child.isPdf ? "_blank" : undefined}
                        rel={child.isExternal || child.isPdf ? "noopener noreferrer" : undefined}
                      >
                        {child.label}
                        {child.isPdf && <span class="badge">PDF</span>}
                        {child.isExternal && (
                          <svg
                            class="ext-icon"
                            width="10"
                            height="10"
                            viewBox="0 0 10 10"
                            fill="none"
                            aria-hidden="true"
                          >
                            <path
                              d="M1 9L9 1M9 1H3M9 1V7"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                            />
                          </svg>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Mobile hamburger -->
    <button
      class="mobile-menu-btn"
      aria-label="Open navigation menu"
      aria-controls="mobile-nav"
      aria-expanded="false"
    >
      <svg
        width="22"
        height="16"
        viewBox="0 0 22 16"
        fill="none"
        aria-hidden="true"
      >
        <line
          class="bar bar-1"
          x1="0"
          y1="1"
          x2="22"
          y2="1"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        ></line>
        <line
          class="bar bar-2"
          x1="0"
          y1="8"
          x2="22"
          y2="8"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        ></line>
        <line
          class="bar bar-3"
          x1="0"
          y1="15"
          x2="22"
          y2="15"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        ></line>
      </svg>
    </button>
  </div>

  <!-- Mobile Nav -->
  <nav
    class="mobile-nav"
    id="mobile-nav"
    aria-label="Mobile navigation"
    hidden
  >
    <ul
      class="mobile-nav-list"
      role="list"
    >
      {
        navItems.map((item) => (
          <li class="mobile-nav-item">
            {item.children ? (
              <>
                <button class="mobile-nav-link mobile-nav-toggle">
                  {item.label}
                  <svg
                    width="10"
                    height="6"
                    viewBox="0 0 10 6"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M1 1L5 5L9 1"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    />
                  </svg>
                </button>
                <ul
                  class="mobile-subnav"
                  hidden
                >
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="mobile-subnav-link"
                        target={child.isExternal || child.isPdf ? "_blank" : undefined}
                        rel={child.isExternal || child.isPdf ? "noopener noreferrer" : undefined}
                      >
                        {child.label} {child.isPdf ? "(PDF)" : ""}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <a
                href={item.href}
                class="mobile-nav-link"
                target={item.isExternal ? "_blank" : undefined}
                rel={item.isExternal ? "noopener noreferrer" : undefined}
              >
                {item.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  /* ---- Skip Link ---- */
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    z-index: 9999;
    background: var(--color-green-dark);
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: top var(--transition-fast);
  }
  .skip-link:focus {
    top: var(--space-3);
    outline: 3px solid var(--color-earth-light);
    outline-offset: 2px;
  }

  /* ---- Header Shell ---- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-white);
    border-bottom: var(--border-thin);
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
    gap: var(--space-8);
  }

  /* ---- Logo ---- */
  .site-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }
  .site-logo-img {
    height: 48px;
    width: auto;
    display: block;
  }

  /* ---- Desktop Nav ---- */
  .main-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: var(--space-1);
  }

  .nav-item {
    position: relative;
    padding-block: 6px;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--color-gray-dark);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition:
      color var(--transition-fast),
      background var(--transition-fast);
    white-space: nowrap;
  }
  .nav-link:hover,
  .nav-link.is-active {
    color: var(--color-green-dark);
    background: var(--color-green-pale);
  }
  .nav-link:focus-visible {
    outline: 2px solid var(--color-green-mid);
    outline-offset: 2px;
  }

  .nav-link--cta {
    margin-left: var(--space-3);
    padding: var(--space-2) var(--space-5);
    background: var(--color-green-dark);
    color: var(--color-white) !important;
    border-radius: var(--radius-md);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }
  .nav-link--cta:hover {
    background: var(--color-green-mid) !important;
    color: var(--color-white) !important;
  }

  .nav-chevron {
    transition: transform var(--transition-fast);
    flex-shrink: 0;
  }
  .has-dropdown:hover .nav-chevron,
  .has-dropdown.is-open .nav-chevron {
    transform: rotate(180deg);
  }

  /* ---- Dropdown ---- */
  .dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 230px;
    background: var(--color-white);
    border: var(--border-thin);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    list-style: none;
    padding: var(--space-2) 0;
    z-index: 200;
    overflow: hidden;
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown.is-open .dropdown {
    display: block;
  }

  .dropdown-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-gray-dark);
    text-decoration: none;
    transition:
      background var(--transition-fast),
      color var(--transition-fast);
  }
  .dropdown-link:hover {
    background: var(--color-green-pale);
    color: var(--color-green-dark);
  }
  .dropdown-link:focus-visible {
    outline: 2px solid var(--color-green-mid);
    outline-offset: -2px;
  }

  .badge {
    font-size: 10px;
    font-weight: 600;
    font-family: var(--font-sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--color-earth-light);
    color: var(--color-earth);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    margin-left: auto;
    opacity: 0.85;
  }
  .ext-icon {
    margin-left: auto;
    opacity: 0.4;
  }

  /* ---- Mobile Menu Button ---- */
  .mobile-menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-gray-dark);
    border-radius: var(--radius-md);
    transition:
      background var(--transition-fast),
      color var(--transition-fast);
  }
  .mobile-menu-btn:hover {
    background: var(--color-green-pale);
    color: var(--color-green-dark);
  }
  .mobile-menu-btn:focus-visible {
    outline: 2px solid var(--color-green-mid);
    outline-offset: 2px;
  }

  /* ---- Mobile Nav ---- */
  .mobile-nav {
    border-top: var(--border-thin);
    background: var(--color-white);
    padding: var(--space-3) 0 var(--space-4);
  }
  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav-list {
    list-style: none;
  }

  .mobile-nav-link,
  .mobile-nav-toggle {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    min-height: 44px;
    padding: var(--space-3) var(--space-6);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-gray-dark);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition:
      color var(--transition-fast),
      background var(--transition-fast);
  }
  .mobile-nav-link:hover,
  .mobile-nav-toggle:hover {
    color: var(--color-green-dark);
    background: var(--color-green-pale);
  }

  .mobile-subnav {
    list-style: none;
  }
  .mobile-subnav[hidden] {
    display: none;
  }

  .mobile-subnav-link {
    display: block;
    min-height: 44px;
    padding: var(--space-3) var(--space-6) var(--space-3) var(--space-10);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-gray-mid);
    text-decoration: none;
    line-height: 1.6;
    display: flex;
    align-items: center;
  }
  .mobile-subnav-link:hover {
    color: var(--color-green-dark);
  }

  /* ---- Responsive ---- */
  @media (max-width: 960px) {
    .main-nav {
      display: none;
    }
    .mobile-menu-btn {
      display: flex;
    }
  }
</style>

<script>
  // Mobile menu toggle
  const btn = document.querySelector(".mobile-menu-btn") as HTMLButtonElement;
  const mobileNav = document.getElementById("mobile-nav") as HTMLElement;

  btn?.addEventListener("click", () => {
    const isOpen = mobileNav.hidden === false;
    mobileNav.hidden = isOpen;
    btn.setAttribute("aria-expanded", String(!isOpen));
  });

  // Mobile sub-nav toggles
  document.querySelectorAll(".mobile-nav-toggle").forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const subnav = toggle.nextElementSibling as HTMLElement;
      if (subnav) subnav.hidden = !subnav.hidden;
    });
  });

  // Desktop: keyboard-accessible dropdowns
  document.querySelectorAll(".nav-link--toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".has-dropdown");
      const isOpen = item?.classList.contains("is-open");
      document.querySelectorAll(".has-dropdown").forEach((el) => el.classList.remove("is-open"));
      if (!isOpen) item?.classList.add("is-open");
      btn.setAttribute("aria-expanded", String(!isOpen));
    });
  });

  // Close dropdowns on outside click
  document.addEventListener("click", (e) => {
    if (!(e.target as Element).closest(".has-dropdown")) {
      document.querySelectorAll(".has-dropdown").forEach((el) => el.classList.remove("is-open"));
    }
  });
</script>
