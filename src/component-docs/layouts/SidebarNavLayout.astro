---
import Button from "@core-elements/button/Button.astro";
import Icon from "@core-elements/icon/Icon.astro";
import navData from "../data/nav.json";
import { generateNavData } from "../utils/navGenerator.js";

const sideNavData = await generateNavData(navData);
---

<div class="library-sidebar">
  <div class="sidebar-logo-container">
    <Icon name="library/logo" size="none" class="sidebar-logo" />
    <Button
      variant="ghost"
      size="sm"
      iconName="arrow-right"
      iconPosition="after"
      text="Back to site"
      link="/"
    />
  </div>
  <nav class="sidebar-nav">
    {sideNavData.map((section: any) => (
      <div class="sidebar-section">
        {section.label && <p class="sidebar-section-label">{section.label}</p>}
        <ul>
          {section.items?.map((item: any) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
</div>

<style is:global>
  .sidebar-logo-container {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin-top: 5px;

    .icon {
      flex: 1;
      max-width: 138px;

      svg {
        height: 100%;
        width: 100%;
      }
    }
  }
  .sidebar-nav ul { list-style: none; padding: 0; margin: 0 0 1rem; }
  .sidebar-nav a { font-size: 0.875rem; color: inherit; text-decoration: none; display: block; padding: 0.25rem 0; }
  .sidebar-nav a:hover { text-decoration: underline; }
  .sidebar-section-label { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.5; margin: 1rem 0 0.4rem; }
</style>
