---
import StructuredData from "@components/utils/StructuredData.astro";
import seoData from "@data/seo.json";
import { SEO } from "astro-seo";
import "@styles/global.css";
import SiteFonts from "@layouts/SiteFonts.astro";

export interface Props {
  title: string;
  description?: string | null;
  keywords?: string[] | null;
  image?: string | null;
  canonical?: string | null;
}
const props = Astro.props;
const formattedTitle = seoData.titleFormat.replace("{title}", props.title);
const pageDescription = props.description || seoData.description;
const pageKeywords = props.keywords?.join(", ") || seoData.keywords;
const pageImage = props.image || seoData.logoSource;
---

<!doctype html>
<html
  lang="en"
  data-theme="light"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link
      rel="icon"
      type="image/x-icon"
      href="/favicon.ico"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <style is:inline>
      @layer reset, base, components, page-sections, utils, overrides;
    </style>
    <SiteFonts />

    {
      import.meta.env.DEV ? (
        <script
          is:inline
          type="module"
          src="/@vite/client"
        />
      ) : null
    }

    <script>
      if (window.inEditorMode) {
        import("../../live-editing");
        import("../../editor-live-sync");
      }
    </script>
    <script>
      import "../scripts/ge-animations";
    </script>

    <SEO
      title={formattedTitle}
      description={pageDescription}
      openGraph={{
        basic: {
          title: formattedTitle,
          type: "website",
          image: pageImage,
        },
        optional: {
          description: pageDescription,
        },
      }}
      extend={{
        link: [
          {
            rel: "canonical",
            href: props.canonical || Astro.url.href,
          },
        ],
        meta: [
          ...(pageKeywords ? [{ name: "keywords", content: pageKeywords }] : []),
          ...(seoData.hideFromSearchEngines ? [{ name: "robots", content: "noindex, nofollow" }] : []),
        ],
      }}
    />

    <StructuredData site={seoData} />
    <link
      rel="sitemap"
      type="application/xml"
      title="Sitemap"
      href="/sitemap-index.xml"
    />
    <slot name="head" />
  </head>
  <body>
    <div>
      <slot />
    </div>
  </body>
</html>
