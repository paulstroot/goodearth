  /* ══════════════════════════════════════════
   PARALLAX BANNER
══════════════════════════════════════════ */
  .st-banner {
    position: relative;
    height: clamp(480px, 68vh, 760px);
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .st-banner-media {
