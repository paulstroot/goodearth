    .st-img-col:last-child {
      display: flex;
    }
    .st-img-col:nth-child(2) {
      display: none;
    }
    .st-hero-title {
      font-size: clamp(2.8rem, 13vw, 5rem);
      line-height: 0.95;
    }
    .st-hero-content {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }
</style>

<script>
  (function () {
    // ── 1. Scroll-reveal ───────────────────────────────────────
    const sel = ".st-up,.st-up-d,.st-up-dl,.st-right,.st-right-d,.st-scale,.st-wide";
    const reveals = document.querySelectorAll<HTMLElement>(sel);

    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("is-vis");
            io.unobserve(e.target);
          }
        }),
      { threshold: 0.11 }
    );
    reveals.forEach((el) => io.observe(el));

    // ── 1b. Menu cards: staggered left-to-right fade-in ────────
    const menuGrid = document.querySelector<HTMLElement>(".st-menu-grid");
    if (menuGrid) {
      const menuCards = [...menuGrid.querySelectorAll<HTMLElement>(".st-menu-card")];
      const menuIO = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) {
            menuCards.forEach((card, i) => {
              setTimeout(() => card.classList.add("is-vis"), i * 300);
            });
            menuIO.disconnect();
          }
        },
        { threshold: 0.15 }
      );
      menuIO.observe(menuGrid);
    }

    // ── 2. Parallax ────────────────────────────────────────────
    const heroImg = document.querySelector<HTMLElement>(".st-hero-img");
    const heroContent = document.querySelector<HTMLElement>(".st-hero-content");
    const heroEl = document.querySelector<HTMLElement>(".st-hero");
    const bannerEl = document.querySelector<HTMLElement>(".st-banner");
    const bannerImg = document.querySelector<HTMLElement>(".st-banner-img");
    const slideImgs = [...document.querySelectorAll<HTMLElement>(".st-img-slide")];

    let ticking = false;

    function update() {
      ticking = false;
      const sy = window.scrollY;
      const vh = window.innerHeight;

      // Hero: image drifts up slowly as page scrolls down
      if (heroImg) {
        heroImg.style.transform = `translateY(${sy * 0.26}px)`;
      }

      // Hero text: drifts down as user scrolls, so by the time the hero exits
      // the text is back at roughly its original (pre-raise) visual position.
      if (heroContent && heroEl) {
        const heroH = heroEl.offsetHeight;
        const progress = Math.min(sy / heroH, 1);
        heroContent.style.transform = `translateY(${progress * 170}px)`;
      }

      // Banner: image moves at 55% of scroll speed within its section
      if (bannerImg && bannerEl) {
        const rect = bannerEl.getBoundingClientRect();
        const mid = vh / 2 - rect.top - rect.height / 2;
        bannerImg.style.transform = `translateY(${mid * 0.28}px)`;
      }

      // Grid images: each "slides" down within its clipped container as it scrolls past.
      // Use the img's own rect (not the wrapper's) so the wrapper's scale transform
      // doesn't skew the position calculation.
      slideImgs.forEach((img) => {
        const rect = img.getBoundingClientRect();
        const progress = (vh - rect.top) / (vh + rect.height);
        const clamped = Math.max(0, Math.min(1, progress));
        img.style.transform = `translateY(${(clamped * 2 - 1) * 52}px)`;
      });
    }

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );

    update();
  })();
</script>
