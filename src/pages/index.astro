  /* ══════════════════════════════════════════
   SCROLL-REVEAL ANIMATIONS
══════════════════════════════════════════ */
  .st-up,
  .st-up-d,
  .st-up-dl {
    opacity: 0;
    transform: translateY(34px);
  }
  .st-up {
    transition:
      opacity 0.9s ease,
      transform 0.9s ease;
  }
  .st-up-d {
    transition:
      opacity 0.9s ease 0.16s,
      transform 0.9s ease 0.16s;
  }
  .st-up-dl {
    transition:
      opacity 0.9s ease 0.32s,
      transform 0.9s ease 0.32s;
  }

  .st-right,
  .st-right-d {
    opacity: 0;
    transform: translateX(34px);
  }
  .st-right {
    transition:
      opacity 1s ease,
      transform 1s ease;
  }
  .st-right-d {
    transition:
      opacity 1s ease 0.26s,
      transform 1s ease 0.26s;
  }

  .st-scale {
    opacity: 0;
    transform: scale(1.07);
    transition:
      opacity 1.3s ease,
      transform 1.5s ease;
  }

  .st-wide {
    opacity: 0;
    transform: translateY(52px);
    transition:
      opacity 1.2s ease,
      transform 1.2s ease;
  }

  .st-up.is-vis,
  .st-up-d.is-vis,
  .st-up-dl.is-vis,
  .st-right.is-vis,
  .st-right-d.is-vis,
  .st-scale.is-vis,
  .st-wide.is-vis {
    opacity: 1;
    transform: none;
  }

  /* ══════════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════════ */
  @media (max-width: 960px) {
    .st-intro-cols {
      flex-direction: column;
      gap: 2rem;
    }
