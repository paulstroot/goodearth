---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Home"
  description="Natural, Unprocessed. Good Earth Restaurant in Edina, MN. Seasonal, fresh, responsibly sourced food served daily since 1974."
>
  <div class="st-page">
    <!-- ── 1. HERO ─────────────────────────────────────────── -->
    <section
      class="st-hero"
      aria-label="Good Earth Restaurant"
    >
      <div class="st-hero-media">
        <img
          class="st-hero-img"
          src="/images/pexels-elina-sazonova-1850600.jpg"
          alt=""
          width="1600"
          height="1067"
          fetchpriority="high"
        />
      </div>
      <div
        class="st-hero-veil"
        aria-hidden="true"
      >
      </div>
      <div class="st-hero-content">
        <span class="st-sub">Good Earth Restaurant · Edina, Minnesota</span>
        <h1 class="st-hero-title">
          <span><em>Natural,</em><br />Unprocessed.</span>
        </h1>
      </div>
      <div
        class="st-hero-scroll"
        aria-hidden="true"
      >
        <svg
          width="18"
          height="32"
          viewBox="0 0 18 32"
          fill="none"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
        >
          <line
            x1="9"
            y1="0"
            x2="9"
            y2="28"
          ></line>
          <polyline points="2,21 9,28 16,21"></polyline>
        </svg>
      </div>
      <!-- Asymmetric curved bottom edge — deeper on the left, shallow on the right -->
      <div
        class="st-hero-curve"
        aria-hidden="true"
      >
        <svg
          viewBox="0 0 1440 240"
          preserveAspectRatio="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            class="st-hero-curve-fill"
            d="M0,240 L0,100 C280,92 520,20 820,100 C1020,152 1260,216 1440,196 L1440,240 Z"
          ></path>
        </svg>
      </div>
    </section>

    <!-- ── 2. THE RESTAURANT ─────────────────────────────── -->
    <section class="st-section">
      <div class="st-wrap">
        <div class="st-intro-cols">
          <div class="st-intro-left">
            <span class="st-sub st-up">The Restaurant</span>
            <h2 class="st-title-l st-up-d">
              <span><em>A good meal begins</em><br />with good soil.</span>
            </h2>
          </div>
          <div class="st-intro-right">
            <p class="st-body st-right">
              Since 1974, Good Earth has nourished Edina with seasonal, organic, and responsibly
              sourced food. We know every farmer, every ingredient — because we believe what goes
              into your body should nourish, not compromise.
            </p>
            <a
              href="/about"
              class="st-btn st-btn--dark st-up-dl"
              >Discover more</a
            >
          </div>
        </div>
      </div>

      <!-- Double image grid -->
      <div class="st-img-grid-outer">
        <div class="st-img-grid">
          <div class="st-img-col">
            <div class="st-img-wrap st-scale">
              <img
                class="st-img-slide"
                src="/images/pexels-annaelle-quionquion-2652658-15279908.jpg"
                alt=""
                width="1100"
                height="826"
                loading="lazy"
              />
            </div>
            <div class="st-img-wrap st-scale">
              <img
                class="st-img-slide"
                src="/images/pexels-sam-lion-5709296.jpg"
                alt=""
                width="1100"
                height="825"
                loading="lazy"
              />
            </div>
          </div>

          <div class="st-img-col">
            <div class="st-img-wrap st-scale">
              <img
                class="st-img-slide"
                src="/images/pexels-gustavo-fring-5622165.jpg"
                alt=""
                width="1100"
                height="826"
                loading="lazy"
              />
            </div>
            <div class="st-img-wrap st-scale">
              <img
                class="st-img-slide"
                src="/images/pexels-valeriya-16204678.jpg"
                alt=""
                width="1100"
                height="1467"
                loading="lazy"
              />
            </div>
          </div>

          <div class="st-img-col">
            <div class="st-img-wrap st-scale">
              <img
                class="st-img-slide"
                src="/images/pexels-shootsaga-31610378.jpg"
                alt=""
                width="1100"
                height="826"
                loading="lazy"
              />
            </div>
            <div class="st-img-wrap st-scale">
              <img
                class="st-img-slide"
                src="/images/pexels-tamira-kanemagi-2159935915-36567404.jpg"
                alt=""
                width="1100"
                height="825"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Image + Quote -->
      <div class="st-wrap">
        <div class="st-quote-cols">
          <div class="st-quote-img st-wide">
            <img
              src="/images/pexels-wolfart-32383596.jpg"
              alt=""
              width="900"
              height="675"
              loading="lazy"
            />
          </div>
          <div class="st-quote-body">
            <p class="st-quote st-right">
              <em
                >"The atmosphere of a place, the warmth of a room, the directness from soil to plate
                — this is Good Earth."</em
              >
            </p>
            <div class="st-right-d">
              <span class="st-quote-name">Good Earth</span>
              <span class="st-quote-desc">Edina, Minnesota — since 1974</span>
            </div>
          </div>
        </div>
      </div>

      <!-- All Menus -->
      <div class="st-wrap st-menus-block st-up">
        <div class="st-menus-header">
          <span class="st-sub">All Menus</span>
          <h2 class="st-title-l"><span><em>Something for</em><br />every appetite</span></h2>
        </div>
        <div class="st-menu-grid">
          <a href="/pdfs/Good_Earth_Specials_Menu.pdf" target="_blank" rel="noopener noreferrer" class="st-menu-card">
            <div class="st-menu-card-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            </div>
            <div class="st-menu-card-text">
              <strong>Seasonal Specials</strong>
              <span>PDF →</span>
            </div>
          </a>
          <a href="/pdfs/Good_Earth_Breakfast_Menu.pdf" target="_blank" rel="noopener noreferrer" class="st-menu-card">
            <div class="st-menu-card-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            </div>
            <div class="st-menu-card-text">
              <strong>Breakfast Menu</strong>
              <span>PDF →</span>
            </div>
          </a>
          <a href="/pdfs/Good_Earth_Lunch_Dinner_Menu.pdf" target="_blank" rel="noopener noreferrer" class="st-menu-card">
            <div class="st-menu-card-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3zm0 0v7"/></svg>
            </div>
            <div class="st-menu-card-text">
              <strong>Lunch &amp; Dinner</strong>
              <span>PDF →</span>
            </div>
          </a>
          <a href="/pdfs/Good_Earth_Kids_Menu.pdf" target="_blank" rel="noopener noreferrer" class="st-menu-card">
            <div class="st-menu-card-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <div class="st-menu-card-text">
              <strong>Kids Menu</strong>
              <span>PDF →</span>
            </div>
          </a>
          <a href="/pdfs/Good-Earth-Event-Platters.pdf" target="_blank" rel="noopener noreferrer" class="st-menu-card">
            <div class="st-menu-card-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
            </div>
            <div class="st-menu-card-text">
              <strong>Event Platters</strong>
              <span>PDF →</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- ── 3. PARALLAX BANNER ─────────────────────────────── -->
    <section
      class="st-banner"
      aria-label="Our philosophy"
    >
      <div class="st-banner-media">
        <img
          class="st-banner-img"
          src="/images/pexels-mike-468229-1192034.jpg"
          alt=""
          width="1920"
          height="1280"
          loading="lazy"
        />
      </div>
      <div
        class="st-banner-veil"
        aria-hidden="true"
      >
      </div>
      <div class="st-banner-content">
        <div class="st-wrap-small">
          <div class="st-banner-cols">
            <div class="st-banner-left">
              <span class="st-sub st-sub--light st-up">The Philosophy</span>
              <h2 class="st-title-l st-title--light st-up-d">
                <span><em>In harmony</em><br />with nature</span>
              </h2>
            </div>
            <div class="st-banner-right">
              <p class="st-body st-body--light st-right">
                It took conviction to serve truly natural food in a world of shortcuts. At Good
                Earth we've always believed the most direct connection to the land produces the most
                nourishing plate.
              </p>
              <a
                href="/about"
                class="st-btn st-btn--light st-up-dl"
                >Learn our story</a
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 4. SINCE 1974 ─────────────────────────────────── -->
    <section class="st-section">
      <div class="st-wrap-left">
        <div class="st-tradition-cols">
          <div class="st-tradition-text">
            <span class="st-sub st-up">Since 1974</span>
            <h2 class="st-title-l st-up-d">
              <span><em>Tradition meets</em><br />freshness</span>
            </h2>
            <p class="st-body st-tradition-body st-up-d">
              Every dish reflects decades of relationships with local growers, sustainable farms,
              and passionate cooks who know that real food makes a real difference.
            </p>
            <a
              href="/pdfs/Good_Earth_Specials_Menu.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="st-btn st-btn--dark st-up-dl"
              >View seasonal menu</a
            >
          </div>
          <div class="st-tradition-img st-wide">
            <img
              src="/images/pexels-cristian-rojas-8230026.jpg"
              alt=""
              width="650"
              height="488"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ── 5. CLOSING QUOTE ───────────────────────────────── -->
    <section class="st-section st-section--close">
      <div class="st-wrap">
        <div class="st-final-cols">
          <div class="st-final-img st-wide">
            <img
              src="/images/pexels-antonette-reyes-1123173-2526987.jpg"
              alt=""
              width="900"
              height="675"
              loading="lazy"
            />
          </div>
          <div class="st-final-text">
            <p class="st-quote st-right">
              <em
                >"We give the food the time and care it needs to develop its very own character."</em
              >
            </p>
            <div class="st-right-d">
              <span class="st-quote-name">Good Earth Kitchen</span>
              <span class="st-quote-desc">Edina, Minnesota</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ─── Page wrapper ─── */
  .st-page {
    --bg: #f3f1eb;
    --text: #1a1a1a;
    --mid: #555;
    --gold: #8c6e3c;
    background: var(--bg);
    color: var(--text);
  }

  /* ─── Containers ─── */
  .st-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 5vw, 6rem);
  }
  .st-wrap-small {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 5vw, 6rem);
  }
  .st-wrap-left {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 5vw, 3rem) 0 clamp(1.5rem, 5vw, 6rem);
  }

  /* ─── Typography tokens ─── */
  .st-sub {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.1rem;
  }
  .st-sub--light {
    color: rgba(255, 255, 255, 0.5);
  }

  .st-title-l {
    font-family: var(--font-headline);
    font-weight: 300;
    font-size: clamp(2.8rem, 5vw, 5.2rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0 0 2rem;
  }
  .st-title-l em {
    font-style: italic;
  }
  .st-title--light {
    color: #fff;
  }

  .st-body {
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 1.05vw, 1rem);
    line-height: 1.85;
    color: var(--mid);
    margin: 0 0 2rem;
    max-width: 460px;
  }
  .st-body--light {
    color: rgba(255, 255, 255, 0.72);
    max-width: 420px;
  }

  /* ─── Buttons ─── */
  .st-btn {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.9em 2.2em;
    border: 1px solid transparent;
    transition:
      background 220ms ease,
      color 220ms ease,
      border-color 220ms ease;
  }
  .st-btn--dark {
    background: var(--text);
    color: #fff;
    border-color: var(--text);
  }
  .st-btn--dark:hover {
    background: #333;
    border-color: #333;
  }
  .st-btn--light {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
  }
  .st-btn--light:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: #fff;
  }

  /* ══════════════════════════════════════════
   HERO
══════════════════════════════════════════ */
  .st-hero {
    position: relative;
    height: calc(100svh - var(--nav-height));
    min-height: 480px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    background: #111;
  }
  .st-hero-media {
    position: absolute;
    inset: -15% 0 0;
  }
  .st-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
    will-change: transform;
  }
  .st-hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(8, 6, 4, 0.9) 0%,
      rgba(8, 6, 4, 0.42) 42%,
      rgba(8, 6, 4, 0.08) 100%
    );
    z-index: 1;
  }
  .st-hero-content {
    position: relative;
    z-index: 2;
    padding: 0 clamp(1.5rem, 6vw, 7rem) clamp(8rem, 40vh, 26rem);
    color: #fff;
    will-change: transform;
  }
  .st-hero-content .st-sub {
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 1.2rem;
  }
  .st-hero-title {
    font-family: var(--font-headline);
    font-weight: 300;
    font-size: clamp(5rem, 11vw, 11rem);
    line-height: 0.8;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0;
    animation: st-hero-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }
  .st-hero-title em {
    font-style: italic;
  }
  .st-hero-content .st-sub {
    animation: st-hero-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0s both;
  }
  @keyframes st-hero-in {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .st-hero-curve {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    z-index: 3;
    pointer-events: none;
    line-height: 0;
  }
  .st-hero-curve svg {
    display: block;
    width: 100%;
    height: clamp(120px, 17vw, 240px);
  }
  .st-hero-curve-fill {
    fill: var(--bg);
  }

  .st-hero-scroll {
    position: absolute;
    bottom: 2.5rem;
    right: clamp(1.5rem, 4vw, 4rem);
    z-index: 4;
    color: rgba(255, 255, 255, 0.35);
    animation: st-bob 2.4s ease-in-out infinite;
  }
  @keyframes st-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  /* ══════════════════════════════════════════
   SECTION
══════════════════════════════════════════ */
  .st-section {
    background: var(--bg);
    padding: clamp(5rem, 9vh, 9rem) 0;
  }
  .st-section--close {
    padding-bottom: clamp(6rem, 12vh, 12rem);
  }

  /* ─── Intro two-col ─── */
  .st-intro-cols {
    display: flex;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: flex-start;
    margin-bottom: clamp(5rem, 8vh, 8rem);
  }
  .st-intro-left {
    flex: 0 0 50%;
  }
  .st-intro-right {
    flex: 1;
    padding-top: 0.6rem;
  }

  /* ─── Double image grid ─── */
  .st-img-grid-outer {
    padding: 0 clamp(1rem, 2.5vw, 3.5rem);
    margin-bottom: clamp(5rem, 8vh, 8rem);
  }
  .st-img-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.3rem, 0.5vw, 0.6rem);
    height: clamp(600px, 80vh, 900px);
  }
  .st-img-col {
    display: flex;
    flex-direction: column;
    gap: clamp(0.3rem, 0.5vw, 0.6rem);
    height: 100%;
    overflow: hidden;
  }
  /* Staggered split heights per column */
  .st-img-col:nth-child(1) .st-img-wrap:nth-child(1) {
    flex: 54;
  }
  .st-img-col:nth-child(1) .st-img-wrap:nth-child(2) {
    flex: 46;
  }
  .st-img-col:nth-child(2) .st-img-wrap:nth-child(1) {
    flex: 38;
  }
  .st-img-col:nth-child(2) .st-img-wrap:nth-child(2) {
    flex: 62;
  }
  .st-img-col:nth-child(3) .st-img-wrap:nth-child(1) {
    flex: 63;
  }
  .st-img-col:nth-child(3) .st-img-wrap:nth-child(2) {
    flex: 37;
  }

  .st-img-wrap {
    overflow: hidden;
    line-height: 0;
    min-height: 0; /* allow flex children to shrink below content size */
  }
  .st-img-wrap img {
    display: block;
    width: 100%;
    height: calc(100% + 120px); /* extra room for parallax travel */
    object-fit: cover;
    margin-top: -60px; /* centre the extra height */
    will-change: transform;
  }

  /* ─── Image + quote ─── */
  .st-quote-cols {
    display: flex;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
    margin-bottom: clamp(4rem, 7vh, 7rem);
  }
  .st-quote-img {
    flex: 0 0 58%;
    aspect-ratio: 3/2;
    overflow: hidden;
  }
  .st-quote-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .st-quote-body {
    flex: 1;
  }

  .st-quote {
    font-family: var(--font-headline);
    font-weight: 300;
    font-size: clamp(1.4rem, 2vw, 2.1rem);
    line-height: 1.4;
    color: var(--text);
    margin: 0 0 1.5rem;
  }
  .st-quote em {
    font-style: italic;
  }
  .st-quote-name {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }
  .st-quote-desc {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    color: #999;
    letter-spacing: 0.07em;
  }

  /* ─── All Menus ─── */
  .st-menus-block {
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    padding-top: clamp(2rem, 4vw, 4rem);
    padding-bottom: clamp(2rem, 4vw, 4rem);
  }
  .st-menus-header {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .st-menus-header .st-title-l {
    margin-bottom: 0;
  }
  .st-menu-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(0.5rem, 1vw, 1rem);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .st-menu-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
