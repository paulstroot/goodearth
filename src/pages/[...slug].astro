---
import MainComponent from "@components/utils/MainComponent.astro";
import Page from "@layouts/Page.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export interface Props {
  page: CollectionEntry<"pages">;
}

export async function getStaticPaths() {
  const pages = await getCollection("pages");

  return pages
    .filter((page) => {
      const slug = page.id.replace(/index$/, "");

      return slug !== "blog";
    })
    .map((page) => {
      const slug = page.id.replace(/index$/, "");

      if (slug.length === 0) return { params: { slug: undefined }, props: { page } };
      return { params: { slug }, props: { page } };
    });
}

const { page } = Astro.props;
const { Content } = await render(page);
const sections = page.data.pageSections ?? [];
---

<Page frontmatter={page.data}>
  {sections.length > 0 && <MainComponent sections={sections} />}
  a<Content />b
</Page>
