---
// src/pages/careers.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/page-sections/page-hero/PageHero.astro';
---

<BaseLayout
  title="Careers"
  description="Work at Good Earth Restaurant. We welcome your interest — passionate people who care about real food and great hospitality."
>
  <div class="ip-page ca-page">

    <!-- ── 1. HERO ─────────────────────────────────────────── -->
    <PageHero
      label="Join the Team"
      title="Work @<br />Good Earth"
      subtitle="Join a team that cares about real food and real people."
      image="/images/pexels-cristian-rojas-8230026.jpg"
      imagePosition="center 60%"
      curveFill="#f3f1eb"
    />

    <!-- ── 2. INTRO ──────────────────────────────────────── -->
    <section class="ip-section">
      <div class="ip-wrap">
        <div class="ca-intro-cols">
          <div class="ca-intro-left">
            <span class="ip-eyebrow ip-up">Opportunities</span>
            <h2 class="ip-display ip-up-d">
              <em>We'd love</em><br />to have you.
            </h2>
          </div>
          <div class="ca-intro-right">
            <p class="ip-prose ip-right">
              We welcome your interest in Good Earth! We're always looking for talented, enthusiastic
              individuals who share our passion for natural, high-quality food and exceptional
              hospitality.
            </p>
            <p class="ip-prose ip-right-d">
              Apply online through our Parasole careers portal — you'll find all available positions
              at Good Earth there. We look forward to hearing from you.
            </p>
            <a
              href="https://parasole.com/careers/#goodearth"
              target="_blank"
              rel="noopener noreferrer"
              class="ip-btn ip-btn--dark ip-up-dl"
            >View Open Positions &amp; Apply</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 3. WHY GOOD EARTH ──────────────────────────────── -->
    <section class="ip-section ca-why-section">
      <div class="ip-wrap">
        <div class="ca-why-header ip-up">
          <span class="ip-eyebrow">Why Good Earth?</span>
          <h2 class="ip-display">
            <em>Good work starts</em><br />with good people.
          </h2>
        </div>
        <div class="ca-standards">

          <div class="ca-standard ip-up">
            <div class="ca-standard-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/>
                <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
              </svg>
            </div>
            <h3 class="ca-standard-title">Real Ingredients</h3>
            <p class="ca-standard-body">
              We work with the best — antibiotic-free meats, sustainable seafood, and locally sourced
              produce. You'll be proud of what you serve.
            </p>
          </div>

          <div class="ca-standard ip-up-d">
            <div class="ca-standard-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            <h3 class="ca-standard-title">Great Community</h3>
            <p class="ca-standard-body">
              A team of people who care deeply about food, guests, and each other. We foster a warm,
              supportive environment where you can grow and thrive.
            </p>
          </div>

          <div class="ca-standard ip-up-dl">
            <div class="ca-standard-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="17" x2="12" y2="21"/><line x1="8" y1="21" x2="16" y2="21"/>
                <path d="M7 4h10v7a5 5 0 0 1-5 5v0a5 5 0 0 1-5-5V4z"/>
                <path d="M7 9H3v-2a4 4 0 0 1 4-4"/>
                <path d="M17 9h4v-2a4 4 0 0 0-4-4"/>
              </svg>
            </div>
            <h3 class="ca-standard-title">Parasole Family</h3>
            <p class="ca-standard-body">
              Part of the respected Parasole Family of Restaurants — a heritage of hospitality with
              opportunities to grow across multiple award-winning concepts.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- ── 4. APPLY CTA ──────────────────────────────────── -->
    <section class="ca-cta ip-up">
      <div class="ip-wrap-sm">
        <span class="ip-eyebrow ca-cta-eyebrow">Ready to apply?</span>
        <h2 class="ca-cta-head">
          <em>Your next chapter</em><br />starts here.
        </h2>
        <p class="ca-cta-body">
          Visit our Parasole careers page to browse current openings at Good Earth and submit your
          application online.
        </p>
        <div class="ca-cta-actions">
          <a
            href="https://parasole.com/careers/#goodearth"
            target="_blank"
            rel="noopener noreferrer"
            class="ip-btn ip-btn--white"
          >View Open Positions &amp; Apply</a>
          <a href="/locations" class="ip-btn ca-btn-ghost">Location &amp; Hours</a>
        </div>
      </div>
    </section>

  </div><!-- /.ca-page -->
</BaseLayout>

<style>
  /* ── Intro ───────────────────────────────────────────── */
  .ca-intro-cols {
    display: flex;
    gap: clamp(3rem, 6vw, 8rem);
    align-items: flex-start;
    margin-bottom: 0;
  }
  .ca-intro-left { flex: 0 0 clamp(240px, 40%, 460px); }
  .ca-intro-right { flex: 1; padding-top: 0.5rem; }
  .ca-intro-right .ip-prose { max-width: none; }

  /* ── Why section ─────────────────────────────────────── */
  .ca-why-section { border-top: 1px solid rgba(0,0,0,0.07); }
  .ca-why-header { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .ca-why-header .ip-display { margin-bottom: 0; }
  .ca-standards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    border-top: 1px solid rgba(0,0,0,0.1);
    padding-top: clamp(2rem, 4vw, 3rem);
  }
  .ca-standard { display: flex; flex-direction: column; gap: 1rem; }
  .ca-standard-icon {
    width: 48px; height: 48px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.04);
    color: var(--ip-gold, #8c6e3c);
    border-radius: 10px;
    flex-shrink: 0;
  }
  .ca-standard-title {
    font-family: var(--font-headline) !important;
    font-weight: 400 !important;
    font-style: italic !important;
    font-size: clamp(1.8rem, 2.8vw, 2.6rem) !important;
    line-height: 1 !important;
    color: var(--ip-text, #1a1a1a) !important;
    margin: 0 !important;
  }
  .ca-standard-body {
    font-family: var(--font-display);
    font-size: 0.9rem;
    line-height: 1.85;
    color: var(--ip-mid, #555);
    margin: 0;
  }

  /* ── Apply CTA ───────────────────────────────────────── */
  .ca-cta {
    background: #1a1a1a;
    padding: clamp(5rem, 10vw, 9rem) 0;
    text-align: center;
  }
  .ca-cta-eyebrow { color: rgba(255,255,255,0.35) !important; }
  .ca-cta-head {
    font-family: var(--font-headline);
    font-weight: 300;
    font-size: clamp(3.2rem, 6vw, 6.4rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
    color: #fff;
    margin: 0 0 1.8rem;
  }
  .ca-cta-head em { font-style: italic; }
  .ca-cta-body {
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
    line-height: 1.8;
    color: rgba(255,255,255,0.5);
    max-width: 520px;
    margin: 0 auto 2.5rem;
  }
  .ca-cta-actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .ca-btn-ghost {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.8rem 1.8rem;
    border-radius: 4px;
    min-height: 44px;
    background: transparent;
    color: rgba(255,255,255,0.55);
    border: 1px solid rgba(255,255,255,0.2);
    transition: color 0.25s ease, border-color 0.25s ease;
  }
  .ca-btn-ghost:hover { color: #fff; border-color: rgba(255,255,255,0.6); }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 900px) {
    .ca-intro-cols { flex-direction: column; gap: 2rem; }
    .ca-intro-left { flex: auto; }
    .ca-standards { grid-template-columns: 1fr; gap: 3rem; }
  }
  @media (max-width: 560px) {
    .ca-cta-actions { flex-direction: column; align-items: center; }
  }
</style>

<script>
  // Scroll-reveal
  (function () {
    const sel = ".ip-up, .ip-up-d, .ip-up-dl, .ip-right, .ip-right-d, .ip-wide";
    const parts = sel.split(", ").map((s) => `.ca-page ${s}`).join(", ");
    const reveals = document.querySelectorAll(parts);
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add("is-vis"); io.unobserve(e.target); }
      }),
      { threshold: 0.1 }
    );
    reveals.forEach((el) => io.observe(el));
  })();
</script>
