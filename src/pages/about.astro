---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Good Earth" description="Everything we believe comes down to one thing: The more direct our connection to the planet, the better off we are.">

  <div class="ab-page">

    <!-- ── 1. HERO ─────────────────────────────────────────────── -->
    <section class="ab-hero">
      <div class="ab-hero-media">
        <img
          class="ab-hero-img"
          src="/images/pexels-ron-lach-8455391.jpg"
          alt=""
          width="1600"
          height="1067"
          fetchpriority="high"
        />
      </div>
      <div class="ab-hero-veil" aria-hidden="true"></div>
      <div class="ab-hero-content">
        <span class="ab-hero-label">Our Story</span>
        <h1 class="ab-hero-title">
          <em>About</em><br />Good Earth.
        </h1>
        <p class="ab-hero-sub">Cooking in harmony with the seasons since 1974.</p>
      </div>
      <div class="ab-hero-curve" aria-hidden="true">
        <svg viewBox="0 0 1440 240" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
          <path class="ab-hero-curve-fill" d="M0,240 L0,100 C280,92 520,20 820,100 C1020,152 1260,216 1440,196 L1440,240 Z"></path>
        </svg>
      </div>
    </section>

    <!-- ── 2. MISSION ──────────────────────────────────────────── -->
    <section class="ab-section">
      <div class="ab-wrap">
        <div class="ab-mission-cols">
          <div class="ab-mission-left">
            <span class="ab-eyebrow ab-up">Since 1974</span>
            <h2 class="ab-display ab-up-d">
              <em>The more direct<br />our connection<br />to the planet,</em><br />the better off<br />we are.
            </h2>
          </div>
          <div class="ab-mission-right">
            <p class="ab-prose ab-right">
              That's why we cook in harmony with the seasons. And why we're fanatical about freshness
              and passionate about purity. It's why we're partial to local growers and organic
              suppliers — and firmly anti-factory farming, hormones, and antibiotics.
            </p>
            <p class="ab-prose ab-right-d">
              Responsibly grown ingredients, carefully handled and lovingly prepared, are better for
              our health. They're better for the environment. And — more than anything else — they
              just taste better. Naturally.
            </p>
            <p class="ab-prose ab-right-d">
              From the critics who praise the quality of our ingredients to the event planners who
              favor our delicious party platters, legions of loyal guests make Good Earth their first
              choice for hearty, healthy everyday eating.
            </p>
            <a href="/locations" class="ab-btn ab-btn--dark ab-up-dl">Find Us in Edina</a>
          </div>
        </div>
      </div>

      <!-- Full-bleed image break -->
      <div class="ab-img-break ab-wide">
        <img
          src="/images/pexels-tamira-kanemagi-2159935915-36567404.jpg"
          alt=""
          width="1600"
          height="900"
          loading="lazy"
        />
      </div>
    </section>

    <!-- ── 3. PARALLAX BANNER ──────────────────────────────────── -->
    <section class="ab-banner" aria-label="Our philosophy">
      <div class="ab-banner-media">
        <img
          class="ab-banner-img"
          src="/images/pexels-mike-468229-1192034.jpg"
          alt=""
          width="1920"
          height="1280"
          loading="lazy"
        />
      </div>
      <div class="ab-banner-veil" aria-hidden="true"></div>
      <div class="ab-banner-content">
        <div class="ab-wrap-small">
          <p class="ab-pullquote ab-up">
            <em>"We give the food the time and care it needs to develop its very own character."</em>
          </p>
          <span class="ab-pullquote-attr ab-up-d">Good Earth Kitchen · Edina, Minnesota</span>
        </div>
      </div>
    </section>

    <!-- ── 4. OUR STANDARDS ────────────────────────────────────── -->
    <section class="ab-section">
      <div class="ab-wrap">

        <div class="ab-standards-intro ab-up">
          <span class="ab-eyebrow">Our Standards</span>
          <h2 class="ab-display ab-up-d">
            <em>What we stand for</em><br />on every plate.
          </h2>
        </div>

        <div class="ab-standards-grid">
          <div class="ab-standard ab-up">
            <div class="ab-standard-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/>
                <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
              </svg>
            </div>
            <h3 class="ab-standard-title">From the Farm</h3>
            <p class="ab-standard-body">
              Good Earth meat and poultry is antibiotic, hormone, and nitrate-free — humanely raised,
              fed a vegetarian diet, and organic where indicated. We know our farmers by name.
            </p>
          </div>

          <div class="ab-standard ab-up-d">
            <div class="ab-standard-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>
                <path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>
                <path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>
              </svg>
            </div>
            <h3 class="ab-standard-title">From the Sea</h3>
            <p class="ab-standard-body">
              We only serve seafood from sustainable sources, harvested by methods that do not harm
              the oceans' ecosystem. Every fish on our menu is chosen with care for what comes next.
            </p>
          </div>

          <div class="ab-standard ab-up-dl">
            <div class="ab-standard-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 20h10"/><path d="M10 20c5.5-2.5.8-6.4 3-10"/>
                <path d="M9.5 9.4c1.1.8 1.8 2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z"/>
                <path d="M14.1 6a7 7 0 0 1 1.7 10.7"/>
                <path d="M14 12.4c.8-1.1 2-1.8 3.7-2.3.4 2 .4 3.5-.3 4.8-.6 1.2-1.9 2.3-4.2 3-.5-2.8 0-4.4.8-5.5z"/>
              </svg>
            </div>
            <h3 class="ab-standard-title">From the Garden</h3>
            <p class="ab-standard-body">
              Seasonal, fresh, unprocessed produce — organic where indicated and locally sourced
              whenever possible. The harvest shapes our menu, not the other way around.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 5. CLOSING CTA ──────────────────────────────────────── -->
    <section class="ab-section ab-section--close">
      <div class="ab-wrap">
        <div class="ab-closing-cols">
          <div class="ab-closing-img ab-wide">
            <img
              src="/images/pexels-cristian-rojas-8230026.jpg"
              alt=""
              width="900"
              height="675"
              loading="lazy"
            />
          </div>
          <div class="ab-closing-text">
            <span class="ab-eyebrow ab-up">Come visit us</span>
            <h2 class="ab-display ab-up-d">
              <em>A table</em><br />for every<br />occasion.
            </h2>
            <p class="ab-prose ab-up-dl">
              Whether it's a quiet breakfast, a working lunch, or a family dinner — there's always a
              place for you at Good Earth. We'd love to see you.
            </p>
            <div class="ab-closing-actions ab-up-dl">
              <a href="/locations" class="ab-btn ab-btn--dark">Location &amp; Hours</a>
              <a href="/careers" class="ab-btn ab-btn--outline">Work With Us</a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div><!-- /.ab-page -->
</BaseLayout>

<style is:global>
  /* ══════════════════════════════════════════
     PAGE WRAPPER — all rules scoped via .ab-page
  ══════════════════════════════════════════ */
  .ab-page {
    --ab-bg:   #f3f1eb;
    --ab-text: #1a1a1a;
    --ab-mid:  #555;
    --ab-gold: #8c6e3c;
    background: var(--ab-bg);
    color: var(--ab-text);
  }

  /* ─── Containers ─── */
  .ab-page .ab-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 5vw, 6rem);
  }
  .ab-page .ab-wrap-small {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 5vw, 6rem);
  }

  /* ─── Typography ─── */
  .ab-page .ab-eyebrow {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ab-gold);
    margin-bottom: 1rem;
  }
  .ab-page .ab-display {
    font-family: var(--font-headline);
    font-weight: 300;
    font-size: clamp(3rem, 5.5vw, 5.6rem);
    line-height: 1.0;
    letter-spacing: -0.01em;
    color: var(--ab-text);
    margin: 0 0 2rem;
  }
  .ab-page .ab-display em { font-style: italic; }
  .ab-page .ab-prose {
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 1.05vw, 1rem);
    line-height: 1.85;
    color: var(--ab-mid);
    margin: 0 0 1.4rem;
    max-width: 500px;
  }
  .ab-page .ab-prose:last-of-type { margin-bottom: 2rem; }

  /* ─── Buttons ─── */
  .ab-page .ab-btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.8rem 1.8rem;
    border-radius: 4px;
    min-height: 44px;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .ab-page .ab-btn--dark {
    background: var(--ab-text);
    color: var(--ab-bg);
    border: 1px solid var(--ab-text);
  }
  .ab-page .ab-btn--dark:hover { background: #333; border-color: #333; color: var(--ab-bg); }
  .ab-page .ab-btn--outline {
    background: transparent;
    color: var(--ab-text);
    border: 1px solid rgba(0,0,0,0.3);
  }
  .ab-page .ab-btn--outline:hover { border-color: var(--ab-text); color: var(--ab-text); }

  /* ─── Sections ─── */
  .ab-page .ab-section { padding: clamp(4rem, 8vw, 8rem) 0; }
  .ab-page .ab-section--close { padding-bottom: clamp(4rem, 8vw, 8rem); }

  /* ══════════════════════════════════════════
     HERO
  ══════════════════════════════════════════ */
  .ab-page .ab-hero {
    position: relative;
    height: calc(100svh - var(--nav-height));
    min-height: 540px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    background: #111;
  }
  .ab-page .ab-hero-media {
    position: absolute;
    inset: 0;
  }
  .ab-page .ab-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
    will-change: transform;
  }
  .ab-page .ab-hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(8, 6, 4, 0.88) 0%,
      rgba(8, 6, 4, 0.5) 40%,
      rgba(8, 6, 4, 0.1) 100%
    );
    z-index: 1;
  }
  .ab-page .ab-hero-content {
    position: relative;
    z-index: 2;
    padding: 0 clamp(1.5rem, 6vw, 7rem) clamp(8rem, 40vh, 26rem);
    color: #fff;
    will-change: transform;
  }
  .ab-page .ab-hero-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
    margin-bottom: 1rem;
    animation: ab-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0s both;
  }
  .ab-page .ab-hero-title {
    font-family: var(--font-headline) !important;
    font-weight: 300 !important;
    font-size: clamp(5rem, 11vw, 11rem) !important;
    line-height: 0.9 !important;
    letter-spacing: -0.02em !important;
    color: #fff !important;
    margin: 0 0 1rem !important;
    animation: ab-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.18s both;
  }
  .ab-page .ab-hero-title em { font-style: italic; }
  .ab-page .ab-hero-sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    color: rgba(255,255,255,0.55);
    margin: 0;
    animation: ab-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
  }
  @keyframes ab-in {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .ab-page .ab-hero-curve {
    position: absolute;
    bottom: 0; left: 0; width: 100%;
    z-index: 3; pointer-events: none; line-height: 0;
  }
  .ab-page .ab-hero-curve svg {
    display: block; width: 100%;
    height: clamp(120px, 17vw, 240px);
  }
  .ab-page .ab-hero-curve-fill { fill: var(--ab-bg); }

  /* ══════════════════════════════════════════
     MISSION
  ══════════════════════════════════════════ */
  .ab-page .ab-mission-cols {
    display: flex;
    gap: clamp(3rem, 6vw, 8rem);
    align-items: flex-start;
    margin-bottom: clamp(3rem, 6vw, 6rem);
  }
  .ab-page .ab-mission-left { flex: 0 0 clamp(280px, 44%, 520px); }
  .ab-page .ab-mission-right { flex: 1; padding-top: 0.5rem; }
  .ab-page .ab-mission-right .ab-prose { max-width: none; }

  /* Full-bleed image break */
  .ab-page .ab-img-break {
    width: 100%;
    height: clamp(340px, 48vw, 560px);
    overflow: hidden;
    line-height: 0;
  }
  .ab-page .ab-img-break img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
    will-change: transform;
  }

  /* ══════════════════════════════════════════
     PARALLAX BANNER
  ══════════════════════════════════════════ */
  .ab-page .ab-banner {
    position: relative;
    height: clamp(440px, 62vh, 700px);
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .ab-page .ab-banner-media {
    position: absolute;
    inset: 0;
  }
  .ab-page .ab-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    display: block;
    will-change: transform;
  }
  .ab-page .ab-banner-veil {
    position: absolute; inset: 0;
    background: rgba(12,10,6,0.64);
    z-index: 1;
  }
  .ab-page .ab-banner-content {
    position: relative; z-index: 2;
    width: 100%; text-align: center;
  }
  .ab-page .ab-pullquote {
    font-family: var(--font-headline);
    font-weight: 300;
    font-size: clamp(2rem, 4vw, 3.8rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: #fff;
    margin: 0 0 1.4rem;
  }
  .ab-page .ab-pullquote em { font-style: italic; }
  .ab-page .ab-pullquote-attr {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
  }

  /* ══════════════════════════════════════════
     STANDARDS
  ══════════════════════════════════════════ */
  .ab-page .ab-standards-intro { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .ab-page .ab-standards-intro .ab-display { margin-bottom: 0; }
  .ab-page .ab-standards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    border-top: 1px solid rgba(0,0,0,0.1);
    padding-top: clamp(2rem, 4vw, 3rem);
  }
  .ab-page .ab-standard {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .ab-page .ab-standard-icon {
    width: 48px; height: 48px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.04);
    color: var(--ab-gold);
    border-radius: 10px;
    flex-shrink: 0;
  }
  .ab-page .ab-standard-title {
    font-family: var(--font-headline) !important;
    font-weight: 400 !important;
    font-style: italic !important;
    font-size: clamp(1.8rem, 2.8vw, 2.6rem) !important;
    line-height: 1 !important;
    color: var(--ab-text) !important;
    margin: 0 !important;
  }
  .ab-page .ab-standard-body {
    font-family: var(--font-display);
    font-size: 0.9rem;
    line-height: 1.85;
    color: var(--ab-mid);
    margin: 0;
  }

  /* ══════════════════════════════════════════
     CLOSING
  ══════════════════════════════════════════ */
  .ab-page .ab-closing-cols {
    display: flex;
    gap: clamp(3rem, 6vw, 7rem);
    align-items: center;
  }
  .ab-page .ab-closing-img {
    flex: 0 0 52%;
    aspect-ratio: 4/3;
    overflow: hidden;
  }
  .ab-page .ab-closing-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .ab-page .ab-closing-text { flex: 1; }
  .ab-page .ab-closing-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ══════════════════════════════════════════
     SCROLL REVEAL
  ══════════════════════════════════════════ */
  .ab-page .ab-up,
  .ab-page .ab-up-d,
  .ab-page .ab-up-dl { opacity: 0; transform: translateY(34px); }
  .ab-page .ab-up    { transition: opacity 0.9s ease, transform 0.9s ease; }
  .ab-page .ab-up-d  { transition: opacity 0.9s ease 0.16s, transform 0.9s ease 0.16s; }
  .ab-page .ab-up-dl { transition: opacity 0.9s ease 0.32s, transform 0.9s ease 0.32s; }
  .ab-page .ab-right   { opacity: 0; transform: translateX(34px); transition: opacity 1s ease, transform 1s ease; }
  .ab-page .ab-right-d { opacity: 0; transform: translateX(34px); transition: opacity 1s ease 0.22s, transform 1s ease 0.22s; }
  .ab-page .ab-wide    { opacity: 0; transform: translateY(52px); transition: opacity 1.2s ease, transform 1.2s ease; }
  .ab-page .ab-up.is-vis, .ab-page .ab-up-d.is-vis, .ab-page .ab-up-dl.is-vis,
  .ab-page .ab-right.is-vis, .ab-page .ab-right-d.is-vis, .ab-page .ab-wide.is-vis {
    opacity: 1; transform: none;
  }

  /* ══════════════════════════════════════════
     RESPONSIVE
  ══════════════════════════════════════════ */
  @media (max-width: 960px) {
    .ab-page .ab-mission-cols { flex-direction: column; gap: 2rem; }
    .ab-page .ab-mission-left { flex: auto; }
    .ab-page .ab-standards-grid { grid-template-columns: 1fr; gap: 3rem; }
    .ab-page .ab-closing-cols { flex-direction: column; }
    .ab-page .ab-closing-img { flex: auto; width: 100%; }
  }
  @media (max-width: 560px) {
    .ab-page .ab-hero-title { font-size: clamp(3rem, 13vw, 5rem) !important; }
    .ab-page .ab-hero-content { padding-left: 1.5rem; padding-right: 1.5rem; }
    .ab-page .ab-closing-actions { flex-direction: column; }
  }
</style>

<script>
  (function () {
    // Scroll-reveal
    const sel = ".ab-up,.ab-up-d,.ab-up-dl,.ab-right,.ab-right-d,.ab-wide";
    const reveals = document.querySelectorAll(sel);
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add("is-vis"); io.unobserve(e.target); }
      }),
      { threshold: 0.11 }
    );
    reveals.forEach((el) => io.observe(el));

    // Parallax
    const heroImg     = document.querySelector(".ab-hero-img");
    const heroContent = document.querySelector(".ab-hero-content");
    const heroEl      = document.querySelector(".ab-hero");
    const bannerEl    = document.querySelector(".ab-banner");
    const bannerImg   = document.querySelector(".ab-banner-img");
    const breakImg    = document.querySelector(".ab-img-break img");
    let ticking = false;

    function update() {
      ticking = false;
      const sy = window.scrollY;
      const vh = window.innerHeight;
      if (heroImg) heroImg.style.transform = `translateY(${sy * 0.26}px)`;
      if (heroContent && heroEl) {
        heroContent.style.transform = `translateY(${Math.min(sy / heroEl.offsetHeight, 1) * 170}px)`;
      }
      if (bannerImg && bannerEl) {
        const rect = bannerEl.getBoundingClientRect();
        bannerImg.style.transform = `translateY(${(vh / 2 - rect.top - rect.height / 2) * 0.28}px)`;
      }
      if (breakImg) {
        const rect = breakImg.getBoundingClientRect();
        const p = Math.max(0, Math.min(1, (vh - rect.top) / (vh + rect.height)));
        breakImg.style.transform = `translateY(${(p * 2 - 1) * 40}px)`;
      }
    }

    window.addEventListener("scroll", () => {
      if (!ticking) { requestAnimationFrame(update); ticking = true; }
    }, { passive: true });
    update();
  })();
</script>
