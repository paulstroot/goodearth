---
// src/pages/menu/seasonal-specials.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Seasonal Specials Menu" description="Good Earth Seasonal Specials — fresh, seasonal ingredients prepared at the peak of perfection.">

  <div class="page-hero">
    <div class="page-hero-bg" aria-hidden="true">
      <img src="/images/pexels-valeriya-25390075.jpg" alt="" width="1200" height="800" fetchpriority="high" />
      <div class="page-hero-overlay"></div>
    </div>
    <div class="container page-hero-content">
      <span class="page-hero-season">Spring 2025</span>
      <h1 class="page-hero-headline">Seasonal<br />Specials</h1>
      <p>Inspired by the season. Made with the best nature has to offer.</p>
    </div>
  </div>

  <section class="section">
    <div class="container specials-wrap">

      <div class="specials-intro">
        <p>Our seasonal specials change with the harvest — featuring the freshest ingredients available from our trusted local and regional growers. Ask your server about today's featured selections.</p>
        <a href="/menu/pdf/Good_Earth_Specials_Menu.pdf" target="_blank" rel="noopener noreferrer" class="btn btn--primary">
          Download Seasonal Specials PDF
        </a>
      </div>

      <hr class="divider" />

      <div class="all-menus">
        <h2 class="menus-headline">All Menus</h2>
        <div class="menu-links-grid">

          <a href="/menu/pdf/Good_Earth_Breakfast_Menu.pdf" target="_blank" rel="noopener noreferrer" class="menu-link-card">
            <div class="menu-link-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
              </svg>
            </div>
            <div><strong>Breakfast Menu</strong><span>PDF →</span></div>
          </a>

          <a href="/menu/pdf/Good_Earth_Lunch_Dinner_Menu.pdf" target="_blank" rel="noopener noreferrer" class="menu-link-card">
            <div class="menu-link-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/>
                <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3zm0 0v7"/>
              </svg>
            </div>
            <div><strong>Lunch &amp; Dinner Menu</strong><span>PDF →</span></div>
          </a>

          <a href="/menu/pdf/Good_Earth_Kids_Menu.pdf" target="_blank" rel="noopener noreferrer" class="menu-link-card">
            <div class="menu-link-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            </div>
            <div><strong>Kids Menu</strong><span>PDF →</span></div>
          </a>

          <a href="/menu/pdf/Good-Earth-Event-Platters.pdf" target="_blank" rel="noopener noreferrer" class="menu-link-card">
            <div class="menu-link-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/>
                <line x1="12" y1="22" x2="12" y2="7"/>
                <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/>
                <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
              </svg>
            </div>
            <div><strong>Event Platters</strong><span>PDF →</span></div>
          </a>

        </div>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
.page-hero {
  position: relative; min-height: 440px;
  display: flex; align-items: flex-end; overflow: hidden; color: var(--color-white);
}
.page-hero-bg { position: absolute; inset: 0; }
.page-hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 40%; display: block; }
.page-hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(26,26,26,0.92) 0%, rgba(26,26,26,0.55) 40%, rgba(26,26,26,0.15) 100%);
}
.page-hero-content { position: relative; z-index: 1; padding-bottom: var(--space-16); padding-top: var(--space-16); }
.page-hero-season {
  display: inline-flex; align-items: center; gap: var(--space-2);
  font-family: var(--font-sans); font-size: var(--text-xs); font-weight: 600;
  letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--color-green-dark); background: var(--color-gold);
  padding: var(--space-2) var(--space-4); border-radius: var(--radius-full); margin-bottom: var(--space-4);
}
.page-hero-headline {
  font-family: var(--font-headline); font-weight: 400; text-transform: uppercase;
  letter-spacing: 0.02em; line-height: 0.88; color: var(--color-white);
  margin-bottom: var(--space-4); font-size: clamp(4rem, 10vw, 8rem);
}
.page-hero-content p {
  color: rgba(255,255,255,0.7); font-family: var(--font-body);
  font-style: italic; font-size: var(--text-lg); margin: 0;
}

/* ---- Specials ---- */
.specials-wrap { max-width: 860px; }
.specials-intro {
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--space-8); margin-bottom: var(--space-10); flex-wrap: wrap;
}
.specials-intro p {
  flex: 1; min-width: 240px; color: var(--color-gray-mid);
  font-size: var(--text-md); margin: 0; line-height: var(--leading-loose);
}

.menus-headline {
  font-family: var(--font-headline); font-weight: 400; text-transform: uppercase;
  font-size: clamp(2.5rem, 5vw, 4rem); letter-spacing: 0.02em; line-height: 0.92;
  color: var(--color-green-dark); margin-bottom: var(--space-6);
}

.menu-links-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); }
.menu-link-card {
  display: flex; align-items: center; gap: var(--space-4);
  padding: var(--space-5) var(--space-6);
  background: var(--color-gray-pale); border: var(--border-thin);
  border-radius: var(--radius-lg); text-decoration: none; color: var(--color-gray-dark);
  transition: all var(--transition-normal);
}
.menu-link-card:hover {
  border-color: var(--color-gold); background: var(--color-gold-light);
  color: var(--color-gray-dark); transform: translateY(-2px); box-shadow: var(--shadow-md);
}
.menu-link-card:focus-visible { outline: 2px solid var(--color-green-mid); outline-offset: 2px; }
.menu-link-icon {
  width: 44px; height: 44px;
  display: flex; align-items: center; justify-content: center;
  background: var(--color-white); color: var(--color-green-dark);
  border-radius: var(--radius-md); flex-shrink: 0;
  transition: background var(--transition-fast), color var(--transition-fast);
}
.menu-link-card:hover .menu-link-icon { background: var(--color-gold); color: var(--color-green-dark); }
.menu-link-card > div:last-child { display: flex; flex-direction: column; gap: 3px; }
.menu-link-card strong { font-family: var(--font-sans); font-size: var(--text-sm); font-weight: 600; color: inherit; }
.menu-link-card span:last-child {
  font-family: var(--font-sans); font-size: var(--text-xs); font-weight: 600;
  letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-green-mid);
}

@media (max-width: 600px) {
  .menu-links-grid { grid-template-columns: 1fr; }
  .specials-intro { flex-direction: column; align-items: flex-start; }
}
</style>
